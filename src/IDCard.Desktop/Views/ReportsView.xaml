<UserControl x:Class="IDCard.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
             
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Mode Buttons (Grid/List Toggle) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="🔲" Width="30" Height="26" Margin="0,0,2,0" Background="#E5E7EB" FontWeight="Bold"/>
            <Button Content="☰" Width="30" Height="26" Background="White" FontWeight="Bold"/>
        </StackPanel>

        <!-- Reports Cards Container -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="25" BorderBrush="#E5E7EB" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">
                
                <!-- Report Card 1: Credentials Issued -->
                <Border Width="220" Height="240" Background="#6B7280" CornerRadius="6" Margin="0,0,20,0" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Chart Preview Box -->
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Height="110" Padding="10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Mock Chart Icon/Bars -->
                                <TextBlock Text="📊" FontSize="36" HorizontalAlignment="Center" Foreground="#059669"/>
                                <TextBlock Text="Week 30, 2013" FontSize="10" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Row="1" Text="Credentials Issued" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <!-- Run Button -->
                        <Button Grid.Row="2" Content="▶ Run" Height="30" Background="#4B5563" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Report Card 2: Credentials Printed -->
                <Border Width="220" Height="240" Background="#6B7280" CornerRadius="6" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Chart Preview Box -->
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Height="110" Padding="10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📊" FontSize="36" HorizontalAlignment="Center" Foreground="#059669"/>
                                <TextBlock Text="Week 30, 2013" FontSize="10" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Row="1" Text="Credentials Printed" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <!-- Run Button -->
                        <Button Grid.Row="2" Content="▶ Run" Height="30" Background="#4B5563" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </Grid>
                </Border>

            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
