<UserControl x:Class="IDCard.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
             
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Mode Buttons (Grid/List Toggle) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="🔲" Width="32" Height="28" Margin="0,0,2,0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" FontWeight="Bold"/>
            <Button Content="☰" Width="32" Height="28" Background="#E5E7EB" BorderBrush="#D1D5DB" BorderThickness="1" FontWeight="Bold"/>
        </StackPanel>

        <!-- Reports Cards Container -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="25" BorderBrush="#E5E7EB" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel Orientation="Horizontal">
                    
                    <!-- Report Card 1: Credentials Issued -->
                    <Border Width="240" Height="250" Background="#6B7280" CornerRadius="6" Margin="0,0,25,20" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Chart Preview Box -->
                            <Border Grid.Row="0" Background="White" CornerRadius="4" Height="120" Padding="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Bar Chart Mockup -->
                                    <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center" Foreground="#059669"/>
                                    <TextBlock Text="Week 30, 2013" FontSize="11" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Title -->
                            <TextBlock Grid.Row="1" Text="Credentials Issued" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Run Button -->
                            <Button Grid.Row="2" Content="▶  Run" Height="34" Background="#4B5563" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Report Card 2: Credentials Printed -->
                    <Border Width="240" Height="250" Background="#6B7280" CornerRadius="6" Margin="0,0,25,20" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Chart Preview Box -->
                            <Border Grid.Row="0" Background="White" CornerRadius="4" Height="120" Padding="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center" Foreground="#059669"/>
                                    <TextBlock Text="Week 30, 2013" FontSize="11" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Title -->
                            <TextBlock Grid.Row="1" Text="Credentials Printed" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Run Button -->
                            <Button Grid.Row="2" Content="▶  Run" Height="34" Background="#4B5563" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                </WrapPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
