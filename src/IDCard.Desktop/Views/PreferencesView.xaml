<UserControl x:Class="IDCard.Desktop.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
    <Border Background="White" CornerRadius="8" Padding="25" BorderBrush="#E5E7EB" BorderThickness="1" Margin="15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Manage Your Preferences" FontSize="22" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,20"/>

                <TextBlock Text="General Preferences" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,10"/>
                <CheckBox Content="Display tooltip for license expiration" Margin="0,0,0,8"/>
                <CheckBox Content="Always show Quick Start on sign in" Margin="0,0,0,8"/>
                <CheckBox Content="Display training tips for designing a credential" Margin="0,0,0,20"/>

                <Separator Background="#E5E7EB" Margin="0,0,0,20"/>

                <TextBlock Text="Printer Preferences" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,10"/>
                <CheckBox Content="Always prompt for printer" IsChecked="True" Margin="0,0,0,15"/>

                <Separator Background="#E5E7EB" Margin="0,0,0,20"/>

                <TextBlock Text="Report Preferences" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Maximum number of records per report" Width="250" VerticalAlignment="Center"/>
                    <TextBox Text="1000" Width="150" Height="28" VerticalContentAlignment="Center" Padding="5,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Width="90" Height="32" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Content="Cancel" Width="90" Height="32" Background="#E5E7EB" Foreground="#374151" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
