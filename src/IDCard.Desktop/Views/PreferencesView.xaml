<UserControl x:Class="IDCard.Desktop.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ဘယ်ဘက်ခြမ်း Side Menu (Preferences / Change Your Password သို့မဟုတ် Test 3 / Test 4) -->
        <Border Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Padding="0,15,0,0">
            <StackPanel>
                <!-- Test 3 / Preferences Tab Button -->
                <Button x:Name="PreferencesNavBtn" 
                        Content="Preferences" 
                        Background="White" 
                        Foreground="#003366" 
                        FontWeight="Bold" 
                        FontSize="13"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Left" 
                        Padding="15,10" 
                        Margin="0,0,0,2"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,1,1,1"/>

                <!-- Test 4 / Change Your Password Tab Button -->
                <Button x:Name="ChangePasswordNavBtn" 
                        Content="Change Your Password" 
                        Background="#F0F0F0" 
                        Foreground="#003366" 
                        FontWeight="SemiBold" 
                        FontSize="13"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Left" 
                        Padding="15,10" 
                        Margin="0,0,0,2"
                        BorderBrush="Transparent"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- ညာဘက်ခြမ်း Main Content Area -->
        <Grid Grid.Column="1" Margin="30,20">
            <!-- Preferences Panel -->
            <StackPanel x:Name="PreferencesPanel" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="500">
                    <StackPanel>
                        <TextBlock Text="Manage Your Preferences" FontSize="22" FontWeight="Normal" Foreground="#003366" Margin="0,0,0,20"/>

                        <!-- General Preferences -->
                        <TextBlock Text="General Preferences" FontWeight="Bold" FontSize="13" Foreground="#333333" Margin="0,0,0,10"/>
                        <CheckBox Content="Display tooltip for license expiration" Margin="0,5"/>
                        <CheckBox Content="Always show Quick Start on sign in" Margin="0,5"/>
                        <CheckBox Content="Display training tips for designing a credential" Margin="0,5"/>

                        <Separator Margin="0,20" Background="#DDDDDD"/>

                        <!-- Printer Preferences -->
                        <TextBlock Text="Printer Preferences" FontWeight="Bold" FontSize="13" Foreground="#333333" Margin="0,0,0,10"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Printer" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Height="26"/>
                        </Grid>
                        <CheckBox Content="Always prompt for printer" Margin="0,10,0,5"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hopper" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Height="26"/>
                        </Grid>

                        <Separator Margin="0,20" Background="#DDDDDD"/>

                        <!-- Quick Start Preferences -->
                        <TextBlock Text="Quick Start Preferences" FontWeight="Bold" FontSize="13" Foreground="#333333" Margin="0,0,0,10"/>
                        <CheckBox Content="Always confirm exit from Quick Start" Margin="0,5"/>

                        <Separator Margin="0,20" Background="#DDDDDD"/>

                        <!-- Report Preferences -->
                        <TextBlock Text="Report Preferences" FontWeight="Bold" FontSize="13" Foreground="#333333" Margin="0,0,0,10"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Maximum number of records per report" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="1000" VerticalAlignment="Center" Padding="4"/>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,30,0,20">
                            <Button Content="Save" Width="90" Height="30" Background="#0066CC" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Width="90" Height="30" Background="#E0E0E0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <!-- Change Password Panel -->
            <StackPanel x:Name="ChangePasswordPanel" Visibility="Collapsed">
                <TextBlock Text="Change Your Password" FontSize="22" FontWeight="Normal" Foreground="#003366" Margin="0,0,0,20"/>
                <!-- Password Fields များကို ဤနေရာတွင် ထည့်သွင်းနိုင်ပါသည် -->
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
