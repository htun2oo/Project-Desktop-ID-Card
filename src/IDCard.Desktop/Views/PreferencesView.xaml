<UserControl x:Class="IDCard.Desktop.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ဘယ်ဘက်ခြမ်း Side Menu -->
        <Border Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Padding="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button x:Name="AccessAttributesBtn" Content="Access Attributes" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                    <Button x:Name="ApplicationSettingsBtn" Content="Application Settings" Background="White" Foreground="#003366" FontWeight="Bold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,-1,2" BorderBrush="#CCCCCC" BorderThickness="1,1,0,1" Click="MenuTab_Click"/>
                    <Button x:Name="AuthenticationBtn" Content="Authentication" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                    
                    <!-- Authentication နှင့် Chip Profiles ကြားသို့ Change Your Password ကို ရွေ့ပြောင်းထည့်သွင်းထားသည်[cite: 13] -->
                    <Button x:Name="ChangePasswordBtn" Content="Change Your Password" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                    
                    <Button x:Name="ChipProfilesBtn" Content="Chip Profiles" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                    <Button x:Name="CustomizationToolkitBtn" Content="Customization Toolkit" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                    <Button x:Name="DataSourcesBtn" Content="Data Sources" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                    <Button x:Name="DevicesBtn" Content="Devices" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                    <Button x:Name="InterfacesBtn" Content="Interfaces" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                    <Button x:Name="LicenseBtn" Content="License" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                    <Button x:Name="LanguagesBtn" Content="Languages" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                    <Button x:Name="PrintingBtn" Content="Printing" Background="#EAEAEA" Foreground="#003366" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,9" Margin="0,0,0,2" BorderBrush="Transparent" BorderThickness="0" Click="MenuTab_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ညာဘက်ခြမ်း Main Content Area -->
        <Grid Grid.Column="1" Margin="30,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SectionTitleText" Text="Application Settings" FontSize="22" FontWeight="Normal" Foreground="#003366" Margin="0,0,0,20"/>

                    <StackPanel x:Name="ContentPanel">
                        <!-- Content Panels -->
                        <TextBlock Text="General Preferences" FontWeight="Bold" FontSize="13" Foreground="#333333" Margin="0,0,0,10"/>
                        <CheckBox Content="Display tooltip for license expiration" Margin="0,5"/>
                        <CheckBox Content="Always show Quick Start on sign in" Margin="0,5"/>
                        <CheckBox Content="Display training tips for designing a credential" Margin="0,5"/>

                        <Separator Margin="0,20" Background="#DDDDDD"/>

                        <StackPanel Orientation="Horizontal" Margin="0,30,0,20">
                            <Button Content="Save" Width="90" Height="30" Background="#0066CC" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Width="90" Height="30" Background="#E0E0E0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
