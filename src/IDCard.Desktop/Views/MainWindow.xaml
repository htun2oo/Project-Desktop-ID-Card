<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        Title="ID Card Management System - Enterprise Edition" Height="750" Width="1200" WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR (Entrust Adaptive Issuance Theme) -->
        <Border Grid.Row="0" Background="#4A154B" BorderBrush="#3F1140" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ENTRUST" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text=" | Adaptive Issuance™ Instant ID" FontSize="11" VerticalAlignment="Center" Foreground="#E0E0E0" Margin="5,2,0,0"/>
                </StackPanel>

                <!-- Main Menu -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Home" FontWeight="Bold" FontSize="14" Margin="15,0" Foreground="White" Background="Transparent" BorderBrush="Transparent"/>
                    <Button Content="Design ▾" FontWeight="Bold" FontSize="14" Margin="15,0" Foreground="#E0E0E0" Background="Transparent" BorderBrush="Transparent"/>
                    <Button Content="Printer Queues" FontWeight="Bold" FontSize="14" Margin="15,0" Foreground="#E0E0E0" Background="Transparent" BorderBrush="Transparent"/>
                </StackPanel>

                <!-- User & Notification Icons (Right Side) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="admin ▾" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" Background="Transparent" BorderBrush="Transparent" Margin="0,0,15,0" Click="AdminButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AdminMenu">
                                <MenuItem Header="Preferences" Click="Preferences_Click"/>
                                <MenuItem Header="Change Your Password"/>
                                <Separator/>
                                <MenuItem Header="Sign Out" Click="SignOut_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="⚙" FontSize="14" Width="28" Height="28" Margin="0,0,5,0" Foreground="Black"/>
                    
                    <!-- Notification with Red Badge '1' -->
                    <Grid Margin="0,0,5,0" Width="28" Height="28">
                        <Button Content="🔔" FontSize="12" Width="28" Height="28"/>
                        <Border Background="Red" CornerRadius="8" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                            <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    
                    <Button Content="❓" FontSize="12" Width="28" Height="28" Margin="0,0,5,0"/>
                    <Button Content="ℹ" FontSize="12" Width="28" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SUB-NAVIGATION BAR -->
        <Border Grid.Row="1" Background="#6B21A8">
            <StackPanel Orientation="Horizontal" Margin="15,0">
                <Button Content="Credentials" Background="White" Foreground="#6B21A8" FontWeight="Bold" Padding="20,5" Margin="0,5,5,0" BorderThickness="0"/>
                <Button Content="Reports" Background="Transparent" Foreground="White" FontWeight="Bold" Padding="20,5" Margin="5,5,0,0" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 3. MAIN CONTENT AREA (Dynamic Workspace for Credentials & PreferencesView) -->
        <Grid Grid.Row="2" Margin="15" x:Name="MainContentArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ဘယ်ဘက်ခြမ်း - Data Form & Input -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Employee ID Card Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="#1F2937"/>

                    <TextBlock Text="Full Name" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Position / Title" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Department" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,0,15"/>

                    <Button Content="Browse Photo" Command="{Binding BrowsePhotoCommand}" Height="32" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                        <Button Content="Save Record" Command="{Binding SaveCommand}" Width="90" Height="32" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,0,8,0"/>
                        <Button Content="Delete" Command="{Binding DeleteCommand}" Width="80" Height="32" Background="#DC2626" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Text="Saved Records List" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" Height="140" DisplayMemberPath="FullName"/>
                </StackPanel>
            </Border>

            <!-- ညာဘက်ခြမ်း - ID Card Live Preview & Actions -->
            <Border Grid.Column="1" Margin="15,0,0,0" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="400" Height="250" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="100" Height="130" Background="#E5E7EB" CornerRadius="6" ClipToBounds="True">
                                <Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="COMPANY ID" FontSize="14" FontWeight="Bold" Foreground="#4F46E5" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Position}" FontSize="13" Foreground="#4B5563" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Department}" FontSize="12" Foreground="#6B7280"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Grid.Row="1" Content="Print ID Card" Height="40" Width="200" HorizontalAlignment="Center" Background="#059669" Foreground="White" FontWeight="Bold" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖨 Printer Queue Status: Ready" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
