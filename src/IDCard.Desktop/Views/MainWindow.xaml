<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        xmlns:views="clr-namespace:IDCard.Desktop.Views"
        Title="Desktop ID Card System"  
        Height="750" Width="1200"  
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="EnterpriseTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="22,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7B21B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:PreferencesViewModel}">
            <views:PreferencesView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="32" Height="32" Margin="0,0,10,0"/>
                    <TextBlock Text="ENTRUST" FontWeight="Bold" FontSize="16" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Rectangle Width="1" Height="24" Fill="#CCCCCC" Margin="0,0,12,0"/>
                    <TextBlock Text="Adaptive Issuance&#x0a;Instant ID" FontSize="11" FontWeight="SemiBold" Foreground="#4A3B5C" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <Button Content="Home" Command="{Binding NavigateHomeCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontWeight="SemiBold" Margin="0,0,15,0"/>
                    
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,15,0">
                        <MenuItem Header="Design ▾" FontWeight="SemiBold" Foreground="#333333" Background="Transparent">
                            <MenuItem Header="Quick Start" Command="{Binding NavigateHomeCommand}"/>
                            <MenuItem Header="Credentials" Command="{Binding NavigateCredentialsCommand}"/>
                            <MenuItem Header="Workflows" Command="{Binding NavigateWorkflowsCommand}"/>
                            <MenuItem Header="Reports" Command="{Binding NavigateDesignReportsCommand}"/>
                            <MenuItem Header="Smart Card Workflows" Command="{Binding NavigateSmartCardWorkflowsCommand}"/>
                            <MenuItem Header="Field Connections" Command="{Binding NavigateFieldConnectionsCommand}"/>
                        </MenuItem>
                    </Menu>

                    <Button Content="Printer Queues" Command="{Binding NavigateReportsCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Last Login at Mon Oct 26 10:42:54 MMT 2026 from IP 192.168.56.1" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,5,0">
                        <MenuItem Header="admin ▾" FontWeight="SemiBold" FontSize="12" Foreground="#333333" Background="Transparent">
                            <MenuItem Header="Preferences" Command="{Binding NavigatePreferencesCommand}"/>
                            <MenuItem Header="Change Your Password"/>
                            <Separator/>
                            <MenuItem Header="Sign Out"/>
                        </MenuItem>
                    </Menu>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="2,0">
                            <MenuItem Header="⚙ ▾" FontSize="14" Foreground="#333333" Background="Transparent">
                                <MenuItem Header="Settings"/>
                                <MenuItem Header="Tools"/>
                                <MenuItem Header="User Management"/>
                                <MenuItem Header="System Dashboard"/>
                            </MenuItem>
                        </Menu>

                        <Button Content="🔔" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontSize="14" Margin="2,0" ToolTip="Notifications"/>
                        <Button Content="❓" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontSize="14" Margin="2,0" ToolTip="Help"/>
                        <Button Content="ℹ" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontSize="14" Margin="2,0" ToolTip="About"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Purple Sub-Header Bar -->
        <Border Grid.Row="1" Background="#6A1B9A" Padding="20,0">
            <ContentControl VerticalAlignment="Center" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Test 1" Command="{Binding NavigateHomeCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource EnterpriseTabButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Test 2" Command="{Binding NavigateHomeCommand}" Margin="2,0,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource EnterpriseTabButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="CredentialDesigns">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚙" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Manage Your Credential Designs" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentPage}" Value="Workflows">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚙" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Manage Your Workflows" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentPage}" Value="DesignReports">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚙" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Manage Your Reports" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentPage}" Value="SmartCardWorkflows">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚙" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Manage Your Smart Card Workflows" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentPage}" Value="FieldConnections">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚙" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Field Connections" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentPage}" Value="Reports">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚙" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Manage Your Printer Queues" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentPage}" Value="Preferences">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚙" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Manage Your Settings" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>

        <!-- 3. Dynamic Content Area with ScrollViewer (Margin ကို 0 သို့ပြောင်း၍ ခရမ်းရောင်ဘားနှင့် တိုက်ရိုက်ကပ်စေခြင်း) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,0">
            <ContentControl Content="{Binding CurrentView}" MinHeight="600"/>
        </ScrollViewer>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Background="#EFEFEF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="🖨 Printer Queue Status: Ready" VerticalAlignment="Center" Margin="15,0" FontSize="12" Foreground="#333333"/>
        </Border>
    </Grid>
</Window>
