<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        xmlns:views="clr-namespace:IDCard.Desktop.Views"
        Title="Desktop ID Card System" 
        Height="750" Width="1200" 
        WindowStartupLocation="CenterScreen"
        Icon="Images/app.ico">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- DataTemplate များဖြင့် View များကို ချိတ်ဆက်ခြင်း -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CredentialsViewModel}">
            <views:CredentialsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Enterprise Header Bar -->
        <Border Grid.Row="0" Background="#4A154B">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ENTRUST" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="| Adaptive Issuance™ Instant ID" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Navigation & Dynamic Content Area -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Navigation Buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="Credentials" 
                        Command="{Binding NavigateCredentialsCommand}" 
                        Width="120" Height="36" 
                        Margin="0,0,10,0" 
                        FontWeight="SemiBold"/>
                
                <Button Content="Reports" 
                        Command="{Binding NavigateReportsCommand}" 
                        Width="120" Height="36" 
                        FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Dynamic Content Area -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="5">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>

        <!-- 3. Footer Status Bar -->
        <Border Grid.Row="2" Background="#EFEFEF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="🖨 Printer Queue Status: Ready" VerticalAlignment="Center" Margin="15,0" FontSize="12" Foreground="#333333"/>
        </Border>
    </Grid>
</Window>
