<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        xmlns:views="clr-namespace:IDCard.Desktop.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="ENTRUST | Adaptive Issuance™ Instant ID" Height="750" Width="1200" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- DataTemplate များဖြင့် View များကို ချိတ်ဆက်ခြင်း -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CredentialsViewModel}">
            <views:CredentialsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F9F9F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#4A154B">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                <TextBlock Text="ENTRUST" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,10,0"/>
                <TextBlock Text="| Adaptive Issuance™ Instant ID" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Navigation Tabs / Content Area -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Navigation Buttons (Credentials & Reports Toggle) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="Credentials" Command="{Binding NavigateCredentialsCommand}" Width="110" Height="35" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <Button Content="Reports" Command="{Binding NavigateReportsCommand}" Width="110" Height="35" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Dynamic Content Area (CurrentView ကို အလိုအလျောက် ပြောင်းလဲပေးမည်) -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="#EFEFEF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="🖨 Printer Queue Status: Ready" VerticalAlignment="Center" Margin="15,0" FontSize="12" Foreground="#333333"/>
        </Border>
    </Grid>
</Window>
