<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDCard.Desktop.Views"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Desktop ID Card System - Enterprise Edition" Height="700" Width="1100" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar (TRUST | Desktop ID Card) -->
        <Border Grid.Row="0" Background="#4A154B">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TRUST" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="| Desktop ID Card" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Right Side Menu (Home, Design, Printer Queues, Admin) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Home" Foreground="White" Background="Transparent" BorderBrush="Transparent" Margin="10,0"/>
                    
                    <!-- Design Dropdown Menu -->
                    <Menu Background="Transparent" Foreground="White" VerticalAlignment="Center">
                        <MenuItem Header="Design" Foreground="White" FontSize="14">
                            <MenuItem Header="Credentials" Foreground="#333333" Command="{Binding NavigateCredentialsCommand}"/>
                                <MenuItem Header="Workflows" Foreground="#333333" Command="{Binding NavigateWorkflowsCommand}"/>
                                <MenuItem Header="Reports" Foreground="#333333" Command="{Binding NavigateReportsCommand}"/>
                                <MenuItem Header="Field Connections" Foreground="#333333" Command="{Binding NavigateFieldConnectionsCommand}"/>
                        </MenuItem>
                    </Menu>

                    <Button Content="Printer Queues" Foreground="White" Background="Transparent" BorderBrush="Transparent" Margin="10,0"/>
                    <Button Content="admin ▾" Foreground="White" Background="Transparent" BorderBrush="Transparent" Margin="10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Sub-Header / Management Title Bar (e.g. Manage Your Credential Designs) -->
        <Border Grid.Row="1" Background="#5C1D5E">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="⚙ Manage Your Credential Designs" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- 3. Main Content Area (Dynamic Views based on Selection) -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentView}" Margin="15"/>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Background="#EFEFEF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="🖨 Printer Queue Status" VerticalAlignment="Center" Margin="15,0" FontSize="12" Foreground="#333333"/>
        </Border>
    </Grid>
</Window>
