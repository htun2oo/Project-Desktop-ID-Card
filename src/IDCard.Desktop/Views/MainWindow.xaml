<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        Title="ID Card Management System" Height="650" Width="1000" WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ဘယ်ဘက်ခြမ်း - Form Inputs & Employee List -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Employee Management" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1F2937"/>

            <TextBlock Text="Full Name" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4" Margin="0,0,0,8"/>

            <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4" Margin="0,0,0,8"/>

            <TextBlock Text="Department" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4" Margin="0,0,0,8"/>

            <Button Content="Browse Photo" Command="{Binding BrowsePhotoCommand}" Height="28" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                <Button Content="Save" Command="{Binding SaveCommand}" Width="75" Height="28" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,0,8,0"/>
                <Button Content="Delete" Command="{Binding DeleteCommand}" Width="75" Height="28" Background="#DC2626" Foreground="White" FontWeight="Bold"/>
            </StackPanel>

            <TextBlock Text="Employee List" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" Height="150" DisplayMemberPath="FullName"/>
        </StackPanel>

        <!-- ညာဘက်ခြမ်း - ID Card Preview -->
        <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380" Height="500">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="COMPANY ID CARD" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2563EB" Margin="0,0,0,25"/>
                
                <!-- ID Card Photo Display -->
                <Border Width="130" Height="130" Background="#E5E7EB" CornerRadius="65" Margin="0,0,0,20" ClipToBounds="True">
                    <Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/>
                </Border>

                <TextBlock Text="{Binding FullName}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#111827"/>
                <TextBlock Text="{Binding Position}" FontSize="15" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding Department, StringFormat='Department: {0}'}" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
