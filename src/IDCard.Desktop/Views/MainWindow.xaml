<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDCard.Desktop.Views"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Desktop ID Card System - Enterprise Edition" Height="700" Width="1100" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- ဒေါင်လိုက်မျဉ်းနှင့် နေရာလွတ်များ လုံးဝမပါရှိစေရန် ပြင်ဆင်ထားသော CleanMenuItemStyle -->
        <Style x:Key="CleanMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1A365D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" Margin="14,10" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu/Popup ၏ ဒေါင်လိုက်မျဉ်း (Gutter) ကို အပြီးအပိုင် ဖယ်ရှားရန် Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F1F1F1" BorderBrush="#CCCCCC" BorderThickness="1" ClipToBounds="True">
                            <ItemsPresenter Margin="-28,0,0,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar -->
        <Border Grid.Row="0" Background="#4A154B">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TRUST" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="| Desktop ID Card" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Right Side Menu -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Home -->
                    <Button Content="Home" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14" Margin="10,0"/>
                    
                    <!-- Design Dropdown Menu (Design ▾ အဖြစ် ပြင်ဆင်ထားသည်) -->
                    <Menu Background="Transparent" Foreground="White" VerticalAlignment="Center">
                        <MenuItem Header="Design ▾" Foreground="White" FontSize="14">
                            <MenuItem Header="Credentials" Style="{StaticResource CleanMenuItemStyle}" Command="{Binding NavigateCredentialsCommand}"/>
                            <MenuItem Header="Workflows" Style="{StaticResource CleanMenuItemStyle}" Command="{Binding NavigateWorkflowsCommand}"/>
                            <MenuItem Header="Reports" Style="{StaticResource CleanMenuItemStyle}" Command="{Binding NavigateReportsCommand}"/>
                            <MenuItem Header="Field Connections" Style="{StaticResource CleanMenuItemStyle}" Command="{Binding NavigateFieldConnectionsCommand}"/>
                        </MenuItem>
                    </Menu>

                    <!-- Printer Queues -->
                    <Button Content="Printer Queues" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14" Margin="10,0"/>
                    
                    <!-- Admin နှင့် ညာဘက် Icon များ -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        
                        <!-- admin Dropdown Menu -->
                        <Menu Background="Transparent" Foreground="White" VerticalAlignment="Center">
                            <MenuItem Header="admin ▾" Foreground="White" FontSize="14">
                                <MenuItem Header="Preferences" Style="{StaticResource CleanMenuItemStyle}"/>
                                <Separator/>
                                <MenuItem Header="Change Your Password" Style="{StaticResource CleanMenuItemStyle}"/>
                                <Separator/>
                                <MenuItem Header="Sign Out" Style="{StaticResource CleanMenuItemStyle}"/>
                            </MenuItem>
                        </Menu>

                        <!-- Settings ⚙ ▾ Dropdown Menu -->
                        <Menu Background="Transparent" Foreground="White" VerticalAlignment="Center">
                            <MenuItem Header="⚙ ▾" Foreground="White" FontSize="14">
                                <MenuItem Header="Settings" Style="{StaticResource CleanMenuItemStyle}"/>
                                <Separator/>
                                <MenuItem Header="Tools" Style="{StaticResource CleanMenuItemStyle}"/>
                                <Separator/>
                                <MenuItem Header="User Management" Style="{StaticResource CleanMenuItemStyle}"/>
                                <Separator/>
                                <MenuItem Header="System Dashboard" Style="{StaticResource CleanMenuItemStyle}"/>
                            </MenuItem>
                        </Menu>
                        
                        <!-- Notification Bell with Badge (🔔 1) -->
                        <Grid Margin="8,0" VerticalAlignment="Center">
                            <Button Content="🔔" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
                            <Border Background="Red" CornerRadius="8" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0">
                                <TextBlock Text="1" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        
                        <!-- Help (?) -->
                        <Button Content="❓" Foreground="White" Background="Transparent" BorderBrush="Transparent" Margin="5,0" FontSize="12"/>
                        <!-- Info (ⓘ) -->
                        <Button Content="ℹ" Foreground="White" Background="Transparent" BorderBrush="Transparent" Margin="5,0" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Sub-Header / Management Title Bar -->
        <Border Grid.Row="1" Background="#5C1D5E">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="⚙ Manage Your Credential Designs" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- 3. Main Content Area -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentView}" Margin="15"/>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Background="#EFEFEF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="🖨 Printer Queue Status" VerticalAlignment="Center" Margin="15,0" FontSize="12" Foreground="#333333"/>
        </Border>
    </Grid>
</Window>
