<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        xmlns:views="clr-namespace:IDCard.Desktop.Views"
        Title="Desktop ID Card System"  
        Height="750" Width="1200"  
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="EnterpriseTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="18,8" Margin="0,0,0,-2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7B21B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10,5" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:PreferencesViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:PrinterQueuesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CredentialsViewModel}">
            <views:CredentialsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="32" Height="32" Margin="0,0,10,0"/>
                    <TextBlock Text="ENTRUST" FontWeight="Bold" FontSize="16" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Rectangle Width="1" Height="24" Fill="#CCCCCC" Margin="0,0,12,0"/>
                    <TextBlock Text="Adaptive Issuance&#x0a;Instant ID" FontSize="11" FontWeight="SemiBold" Foreground="#4A3B5C" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <!-- Home Button -->
                    <Button Command="{Binding NavigateHomeCommand}" Style="{StaticResource TopNavButtonStyle}">
                        <TextBlock Text="Home">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#6A1B9A" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    
                    <!-- Design Button (Drop-down အစား ခလုတ်အဖြစ် ပြောင်းလဲထားခြင်း) -->
                    <Button Command="{Binding NavigateCredentialsCommand}" Style="{StaticResource TopNavButtonStyle}" Margin="5,0">
                        <TextBlock Text="Design">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentPage}" Value="CredentialDesigns"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#6A1B9A" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentPage}" Value="Workflows"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#6A1B9A" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentPage}" Value="DesignReports"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#6A1B9A" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentPage}" Value="FieldConnections"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#6A1B9A" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Printer Queues Button -->
                    <Button Command="{Binding NavigateReportsCommand}" Style="{StaticResource TopNavButtonStyle}">
                        <TextBlock Text="Printer Queues">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Reports">
                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#6A1B9A" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Last Login at Mon Oct 26 10:42:54 MMT 2026 from IP 192.168.56.1" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,5,0">
                        <MenuItem Header="admin ▾" FontWeight="SemiBold" FontSize="12" Foreground="#333333" Background="Transparent">
                            <Separator/>
                            <MenuItem Header="User Management" Command="{Binding NavigateUserManagementCommand}"/>
                            <MenuItem Header="System Dashboard" Command="{Binding NavigateSystemDashboardCommand}"/>
                            <Separator/>
                            <MenuItem Header="Sign Out" Command="{Binding SignOutCommand}"/>
                        </MenuItem>
                    </Menu>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="2,0">
                            <MenuItem Header="⚙ ▾" FontSize="14" Foreground="#333333" Background="Transparent">
                                <MenuItem Header="Settings" Command="{Binding NavigateSettingsCommand}"/>
                                <MenuItem Header="Tools" Command="{Binding NavigateToolsCommand}"/>
                            </MenuItem>
                        </Menu>

                        <Button Content="🔔" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontSize="14" Margin="2,0" ToolTip="Notifications"/>
                        <Button Content="❓" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontSize="14" Margin="2,0" ToolTip="Help"/>
                        <Button Content="ℹ" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontSize="14" Margin="2,0" ToolTip="About"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Purple Sub-Header Bar -->
        <Border Grid.Row="1" Background="#6A1B9A" Padding="20,0,20,0" BorderBrush="#6A1B9A" BorderThickness="0">
            <Grid VerticalAlignment="Bottom">
                <!-- Home Context Sub-Tabs (Credentials & Reports) -->
                <StackPanel Orientation="Horizontal" Margin="0,-4,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Content="Credentials" Command="{Binding NavigateHomeCredentialsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EnterpriseTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HomeSubTab}" Value="Credentials">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#6A1B9A"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Reports" Command="{Binding NavigateHomeReportsCommand}" Margin="2,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EnterpriseTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HomeSubTab}" Value="Reports">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#6A1B9A"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Design Context Sub-Tabs (Credential Design, Workflows, Reports, Field Connections) -->
                <StackPanel Orientation="Horizontal" Margin="0,-4,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="CredentialDesigns">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Workflows">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="DesignReports">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="FieldConnections">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Credential Design Tab -->
                    <Button Content="Credential Design" Command="{Binding NavigateCredentialsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EnterpriseTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="CredentialDesigns">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#6A1B9A"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Workflows Tab -->
                    <Button Content="Workflows" Command="{Binding NavigateWorkflowsCommand}" Margin="2,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EnterpriseTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Workflows">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#6A1B9A"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Reports Tab -->
                    <Button Content="Reports" Command="{Binding NavigateDesignReportsCommand}" Margin="2,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EnterpriseTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="DesignReports">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#6A1B9A"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Field Connections Tab -->
                    <Button Content="Field Connections" Command="{Binding NavigateFieldConnectionsCommand}" Margin="2,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EnterpriseTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="FieldConnections">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#6A1B9A"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- အခြားသော မျက်နှာပြင်များ (ဥပမာ Preferences, Tools စသည်) အတွက် စာသားများပြရန် -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Preferences">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Tools">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="UserManagement">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="SystemDashboard">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <TextBlock Text="⚙" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Preferences">
                                        <Setter Property="Text" Value="Manage Your Settings"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Tools">
                                        <Setter Property="Text" Value="Tools"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="UserManagement">
                                        <Setter Property="Text" Value="User Management"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="SystemDashboard">
                                        <Setter Property="Text" Value="System Dashboard"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Dynamic Content Area with ScrollViewer -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,0">
            <ContentControl Content="{Binding CurrentView}" MinHeight="600"/>
        </ScrollViewer>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Background="#EFEFEF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="🖨 Printer Queue Status: Ready" VerticalAlignment="Center" Margin="15,0" FontSize="12" Foreground="#333333"/>
        </Border>
    </Grid>
</Window>
