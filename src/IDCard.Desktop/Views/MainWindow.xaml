<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDCard.Desktop.Views"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Desktop ID Card System - Enterprise Edition" Height="750" Width="1200" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar -->
        <Border Grid.Row="0" Background="#4A154B">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ENTRUST" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="| Adaptive Issuance™ Instant ID" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Right Side Menu -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Home" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14" Margin="10,0"/>
                    
                    <!-- Design Dropdown Menu -->
                    <Grid Margin="10,0">
                        <ToggleButton x:Name="DesignToggle" Content="Design ▾" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=DesignToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=DesignToggle}" PopupAnimation="Fade">
                            <Border Background="#F1F1F1" BorderBrush="#CCCCCC" BorderThickness="1" Width="180">
                                <StackPanel>
                                    <Button Content="Credentials" Command="{Binding NavigateCredentialsCommand}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                    <Border Height="1" Background="#E0E0E0"/>
                                    <Button Content="Workflows" Command="{Binding NavigateWorkflowsCommand}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                    <Border Height="1" Background="#E0E0E0"/>
                                    <Button Content="Reports" Command="{Binding NavigateReportsCommand}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                    <Border Height="1" Background="#E0E0E0"/>
                                    <Button Content="Field Connections" Command="{Binding NavigateFieldConnectionsCommand}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Content="Printer Queues" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14" Margin="10,0"/>
                    
                    <!-- Admin & Settings Dropdown Menus -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Grid Margin="5,0">
                            <ToggleButton x:Name="AdminToggle" Content="admin ▾" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
                            <Popup IsOpen="{Binding IsChecked, ElementName=AdminToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=AdminToggle}" PopupAnimation="Fade">
                                <Border Background="#F1F1F1" BorderBrush="#CCCCCC" BorderThickness="1" Width="200">
                                    <StackPanel>
                                        <Button Content="Preferences" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                        <Border Height="1" Background="#E0E0E0"/>
                                        <Button Content="Change Your Password" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                        <Border Height="1" Background="#E0E0E0"/>
                                        <Button Content="Sign Out" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Grid Margin="5,0">
                            <ToggleButton x:Name="SettingsToggle" Content="⚙ ▾" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
                            <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=SettingsToggle}" PopupAnimation="Fade">
                                <Border Background="#F1F1F1" BorderBrush="#CCCCCC" BorderThickness="1" Width="180">
                                    <StackPanel>
                                        <Button Content="Settings" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                        <Border Height="1" Background="#E0E0E0"/>
                                        <Button Content="Tools" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                        <Border Height="1" Background="#E0E0E0"/>
                                        <Button Content="User Management" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                        <Border Height="1" Background="#E0E0E0"/>
                                        <Button Content="System Dashboard" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="15,10" Foreground="#1A365D" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        
                        <Grid Margin="8,0" VerticalAlignment="Center">
                            <Button Content="🔔" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
                            <Border Background="Red" CornerRadius="8" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0">
                                <TextBlock Text="1" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        
                        <Button Content="❓" Foreground="White" Background="Transparent" BorderBrush="Transparent" Margin="5,0" FontSize="12"/>
                        <Button Content="ℹ" Foreground="White" Background="Transparent" BorderBrush="Transparent" Margin="5,0" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Sub-Header / Management Title Bar -->
        <Border Grid.Row="1" Background="#5C1D5E">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="⚙" Foreground="White" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Manage Your Credential Designs" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 3. Main Content Area (Credentials View Layout) -->
        <Border Grid.Row="2" Background="#FFFFFF" Margin="15" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Credential Designs Tab -->
                <Border Grid.Row="0" Width="110" Height="45" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1,1,1,0" HorizontalAlignment="Left">
                    <TextBlock Text="Credential&#x0a;Designs" FontSize="11" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <!-- Create Button -->
                <Button Grid.Row="1" Content="Create" Width="80" Height="30" Background="#0067C0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,15,0,15" BorderBrush="Transparent"/>

                <!-- Data Table / Grid View -->
                <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <!-- Filter Row -->
                        <Border Grid.Row="0" Background="#F1F1F1" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#333333"/>
                                <TextBox Width="200" Height="22" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Table Columns Header -->
                        <Border Grid.Row="1" Background="#EFEFEF" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                            <Grid Margin="10,0">
                                <TextBlock Text="Name" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333333"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Created By" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,150,0"/>
                                    <TextBlock Text="Last Modified By" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,50,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- No Data Content -->
                        <TextBlock Grid.Row="2" Text="No data is available." Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Pagination Footer -->
                        <Border Grid.Row="3" Background="#EFEFEF" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
                            <Grid Margin="10,0">
                                <TextBlock Text="Showing 0 - 0 of 0 entries" VerticalAlignment="Center" Foreground="#333333" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="First" Foreground="#0067C0" Margin="5,0" Cursor="Hand"/>
                                    <TextBlock Text="Previous" Foreground="#0067C0" Margin="5,0" Cursor="Hand"/>
                                    <TextBlock Text="Next" Foreground="#0067C0" Margin="5,0" Cursor="Hand"/>
                                    <TextBlock Text="Last" Foreground="#0067C0" Margin="5,0" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Background="#EFEFEF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="🖨 Printer Queue Status" VerticalAlignment="Center" Margin="15,0" FontSize="12" Foreground="#333333"/>
        </Border>
    </Grid>
</Window>
