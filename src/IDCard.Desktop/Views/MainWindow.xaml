<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="ENTRUST | Adaptive Issuance™ Instant ID" Height="750" Width="1200" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="#F9F9F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Enterprise Header Bar -->
        <Border Grid.Row="0" Background="#4A154B">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ENTRUST" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="| Adaptive Issuance™ Instant ID" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Header Actions & Menus -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Home" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14" Margin="5,0"/>
                    
                    <!-- Design Custom Popup Menu -->
                    <Grid Margin="5,0">
                        <ToggleButton x:Name="DesignToggle" Content="Design ▾" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=DesignToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=DesignToggle}" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" Width="180" CornerRadius="4">
                                <StackPanel Padding="4">
                                    <Button Content="Credentials" Command="{Binding NavigateCredentialsCommand}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="10,8"/>
                                    <Border Height="1" Background="#E0E0E0" Margin="0,2"/>
                                    <Button Content="Workflows" Command="{Binding NavigateWorkflowsCommand}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="10,8"/>
                                    <Border Height="1" Background="#E0E0E0" Margin="0,2"/>
                                    <Button Content="Reports" Command="{Binding NavigateReportsCommand}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="10,8"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Content="Printer Queues" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14" Margin="5,0"/>

                    <!-- User Account / Admin Menu -->
                    <Grid Margin="5,0">
                        <ToggleButton x:Name="AdminToggle" Content="admin ▾" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=AdminToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=AdminToggle}" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" Width="180" CornerRadius="4">
                                <StackPanel Padding="4">
                                    <Button Content="Preferences" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="10,8"/>
                                    <Border Height="1" Background="#E0E0E0" Margin="0,2"/>
                                    <Button Content="Change Password" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="10,8"/>
                                    <Border Height="1" Background="#E0E0E0" Margin="0,2"/>
                                    <Button Content="Sign Out" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="10,8"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Content="⚙" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14" Margin="5,0"/>
                    <Button Content="🔔" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="14" Margin="5,0"/>
                    <Button Content="❓" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="12" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Area with Modern TabControl -->
        <Grid Grid.Row="1">
            <TabControl SelectedIndex="0" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource DefaultTabItemStyle}">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </TabControl.Resources>

                <!-- Credentials Tab (Default Selected) -->
                <TabItem Header="Credentials">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- View Toggle Bar (Grid vs List) -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Width="38" Height="32" Content="🪟" ui:ControlHelper.CornerRadius="4,0,0,4" Margin="0,0,1,0"/>
                                <Button Width="38" Height="32" Content="☰" ui:ControlHelper.CornerRadius="0,4,4,0"/>
                            </StackPanel>
                            <Border Height="1" Background="#E0E0E0"/>
                        </StackPanel>

                        <!-- Grid Data Area -->
                        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15">
                            <TextBlock Text="Credentials Management View (Grid Mode Active)" Foreground="#666666" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Reports Tab -->
                <TabItem Header="Reports">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- View Toggle Bar -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Width="38" Height="32" Content="🪟" ui:ControlHelper.CornerRadius="4,0,0,4" Margin="0,0,1,0"/>
                                <Button Width="38" Height="32" Content="☰" ui:ControlHelper.CornerRadius="0,4,4,0"/>
                            </StackPanel>
                            <Border Height="1" Background="#E0E0E0"/>
                        </StackPanel>

                        <!-- Reports Data Area -->
                        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15">
                            <TextBlock Text="System Reports View" Foreground="#666666" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 3. Footer Status Bar -->
        <Border Grid.Row="2" Background="#EFEFEF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="🖨 Printer Queue Status: Ready" VerticalAlignment="Center" Margin="15,0" FontSize="12" Foreground="#333333"/>
        </Border>
    </Grid>
</Window>
