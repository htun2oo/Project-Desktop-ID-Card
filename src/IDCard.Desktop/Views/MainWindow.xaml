<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        Title="Desktop ID Card System - Enterprise Edition" Height="750" Width="1200" WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR (Entrust Adaptive Issuance Theme) -->
        <Border Grid.Row="0" Background="#4A154B" BorderBrush="#3F1140" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TRUST" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text=" | Desktop ID Card" FontSize="14" VerticalAlignment="Center" Foreground="#E0E0E0" Margin="5,2,0,0"/>
                </StackPanel>

                <!-- Main Menu -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Home" FontWeight="Bold" FontSize="14" Margin="15,0" Foreground="White" Background="Transparent" BorderBrush="Transparent"/>
                    <Button Content="Design ▾" FontWeight="Bold" FontSize="14" Margin="15,0" Foreground="#E0E0E0" Background="Transparent" BorderBrush="Transparent"/>
                    <Button Content="Printer Queues" FontWeight="Bold" FontSize="14" Margin="15,0" Foreground="#E0E0E0" Background="Transparent" BorderBrush="Transparent"/>
                </StackPanel>

                <!-- User & Notification Icons (Right Side) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="admin ▾" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" Background="Transparent" BorderBrush="Transparent" Margin="0,0,15,0" Click="AdminButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AdminMenu">
                                <MenuItem Header="Preferences" Click="Preferences_Click"/>
                                <MenuItem Header="Change Your Password"/>
                                <Separator/>
                                <MenuItem Header="Sign Out" Click="SignOut_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="⚙" FontSize="14" Width="28" Height="28" Margin="0,0,5,0" Foreground="Black"/>
                    
                    <!-- Notification with Red Badge '1' -->
                    <Grid Margin="0,0,5,0" Width="28" Height="28">
                        <Button Content="🔔" FontSize="12" Width="28" Height="28"/>
                        <Border Background="Red" CornerRadius="8" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                            <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    
                    <Button Content="❓" FontSize="12" Width="28" Height="28" Margin="0,0,5,0"/>
                    <Button Content="ℹ" FontSize="12" Width="28" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SUB-NAVIGATION BAR (Entrust Instant ID Tabs) -->
        <Border Grid.Row="1" Background="#6B21A8">
            <StackPanel Orientation="Horizontal" Margin="15,0">
                <!-- Credentials Tab Button -->
                <Button x:Name="CredentialsTabBtn" Content="Credentials" Click="CredentialsButton_Click" 
                        Background="White" Foreground="#6B21A8" FontWeight="Bold" 
                        Padding="25,8" Margin="0,0,2,0" BorderThickness="0"/>
        
                <!-- Reports Tab Button -->
                <Button x:Name="ReportsTabBtn" Content="Reports" Click="ReportsButton_Click" 
                        Background="#581C87" Foreground="White" FontWeight="Bold" 
                        Padding="25,8" Margin="0,0,0,0" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 3. MAIN CONTENT AREA (Credentials Blank View with Toggle Buttons) -->
        <Grid Grid.Row="2" Margin="15" x:Name="MainContentArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- View Mode Buttons (Grid/List Toggle) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="🔲" Width="30" Height="26" Margin="0,0,2,0" Background="#E5E7EB" FontWeight="Bold"/>
                <Button Content="☰" Width="30" Height="26" Background="White" FontWeight="Bold"/>
            </StackPanel>

            <!-- Blank Workspace Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ဘယ်ဘက်ခြမ်း အလွတ် (Blank Form Area)[cite: 19] -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1"/>

                <!-- ညာဘက်ခြမ်း အလွတ် (Blank Preview Area)[cite: 19] -->
                <Border Grid.Column="1" Margin="15,0,0,0" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1"/>
            </Grid>
        </Grid>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖨 Printer Queue Status" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
