<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ID Card Management System" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ဘယ်ဘက်ခြမ်း - Input Form (CRUD) -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Employee Information" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#1F2937"/>

            <TextBlock Text="Full Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Height="30" Padding="5" Margin="0,0,0,10"/>

            <TextBlock Text="Position / Title" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Height="30" Padding="5" Margin="0,0,0,10"/>

            <TextBlock Text="Department" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Height="30" Padding="5" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="80" Height="30" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Button Content="Delete" Width="80" Height="30" Background="#DC2626" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- ညာဘက်ခြမ်း - ID Card Preview -->
        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="COMPANY ID CARD" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2563EB" Margin="0,0,0,20"/>
                
                <!-- ID Card Photo Placeholder -->
                <Border Width="120" Height="120" Background="#F3F4F6" CornerRadius="60" Margin="0,0,0,15"/>

                <TextBlock Text="John Doe" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Software Engineer" FontSize="14" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Department: IT" FontSize="14" Foreground="#4B5563" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
