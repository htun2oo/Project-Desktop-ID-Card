<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        xmlns:views="clr-namespace:IDCard.Desktop.Views"
        Title="Desktop ID Card System"  
        Height="750" Width="1200"  
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- DataTemplate များ နှင့် Style များကို သန့်ရှင်းစွာ ထည့်သွင်းခြင်း -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CredentialsViewModel}">
            <views:CredentialsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>

        <!-- Modern Enterprise Tab Button Style -->
        <Style x:Key="EnterpriseTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="22,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7B21B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 1. Enterprise Top Navigation & Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ဘယ်ဘက်ခြမ်း: Logo နှင့် System Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="32" Height="32" Margin="0,0,10,0"/>
                    <TextBlock Text="ENTRUST" FontWeight="Bold" FontSize="16" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Rectangle Width="1" Height="24" Fill="#CCCCCC" Margin="0,0,12,0"/>
                    <TextBlock Text="Adaptive Issuance&#x0a;Instant ID" FontSize="11" FontWeight="SemiBold" Foreground="#4A3B5C" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- အလယ်ပိုင်း: Navigation Menu (Design Dropdown Menu ပါဝင်သည်) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <Button Content="Home" Command="{Binding NavigateCredentialsCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontWeight="SemiBold" Margin="0,0,15,0"/>
                    
                    <!-- Design Dropdown Menu -->
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,15,0">
                        <MenuItem Header="Design ▾" FontWeight="SemiBold" Foreground="#333333" Background="Transparent">
                            <MenuItem Header="Quick Start" Command="{Binding NavigateCredentialsCommand}"/>
                            <MenuItem Header="Credentials" Command="{Binding NavigateCredentialsCommand}"/>
                            <MenuItem Header="Workflows"/>
                            <MenuItem Header="Reports" Command="{Binding NavigateReportsCommand}"/>
                            <MenuItem Header="Smart Card Workflows"/>
                            <MenuItem Header="Field Connections"/>
                        </MenuItem>
                    </Menu>

                    <Button Content="Printer Queues" Command="{Binding NavigateReportsCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- ညာဘက်ခြမ်း: Login Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Last Login at Sat Oct 24 13:04:54 MMT 2026 from IP 192.168.56.1" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="admin ▾" FontSize="12" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Purple Sub-Header Bar (Credentials & Reports Tabs) -->
        <Border Grid.Row="1" Background="#6A1B9A" Padding="15,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <!-- Credentials Button -->
                <Button Content="Credentials"  
                        Command="{Binding NavigateCredentialsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource EnterpriseTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView.GetType()}" Value="{x:Type vm:CredentialsViewModel}">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#6A1B9A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <!-- Reports Button -->
                <Button Content="Reports"  
                        Command="{Binding NavigateReportsCommand}"  
                        Margin="2,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource EnterpriseTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView.GetType()}" Value="{x:Type vm:ReportsViewModel}">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#6A1B9A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- 3. Dynamic Content Area -->
        <Grid Grid.Row="2" Margin="20">
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="5">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Background="#EFEFEF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="🖨 Printer Queue Status: Ready" VerticalAlignment="Center" Margin="15,0" FontSize="12" Foreground="#333333"/>
        </Border>
    </Grid>
</Window>
