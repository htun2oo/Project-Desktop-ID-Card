<Window x:Class="IDCard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:IDCard.Desktop.Views"
        mc:Ignorable="d"
        Title="Desktop ID Card System" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ထိပ်ဆုံး Header Menu (Home, Design, Printer Queues စသည်ဖြင့်) -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ENTRUST" FontWeight="Bold" FontSize="16" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <!-- သင်၏ Navigation Menu ခလုတ်များ ဤနေရာတွင် ရှိမည် -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- အပိုင်း (၁): ပုံမှန် အနေအထားတွင် ပေါ်မည့် ပင်မ Design Tabs များ -->
        <!-- (Credential Designs, Workflow Designs, Report Designs, Field Connections) -->
        <!-- ================================================================= -->
        <StackPanel Grid.Row="1" x:Name="NormalDesignTabs" Background="#7B1FA2" Orientation="Horizontal">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- CurrentPage သည် WorkflowEditor ဖြစ်သွားပါက ဤပင်မ Tabs များ ပျောက်သွားမည် -->
                        <DataTrigger Binding="{Binding CurrentPage}" Value="WorkflowEditor">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            
            <Button Content="Credential Designs" Command="{Binding NavigateCredentialsCommand}" Width="140" Height="40" Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Button Content="Workflow Designs" Command="{Binding NavigateWorkflowsCommand}" Width="140" Height="40" Background="#5E35B1" Foreground="White" BorderThickness="0"/>
            <Button Content="Report Designs" Command="{Binding NavigateDesignReportsCommand}" Width="140" Height="40" Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Button Content="Field Connections" Command="{Binding NavigateFieldConnectionsCommand}" Width="140" Height="40" Background="Transparent" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <!-- ================================================================= -->
        <!-- အပိုင်း (၂): "Create New Workflow" ကို နှိပ်မှ ပေါ်လာမည့် Workflow Editor Tabs များ -->
        <!-- (Workflow Design 1 နှင့် Properties) -->
        <!-- ================================================================= -->
        <StackPanel Grid.Row="1" x:Name="WorkflowEditorTabs" Background="#7B1FA2" Orientation="Horizontal" Visibility="Collapsed">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <!-- CurrentPage သည် WorkflowEditor ဖြစ်လာမှသာ ဤ Tabs များ ပေါ်လာမည် -->
                        <DataTrigger Binding="{Binding CurrentPage}" Value="WorkflowEditor">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            
            <Button Content="Workflow Design 1" Width="150" Height="40" Background="White" Foreground="#7B1FA2" FontWeight="Bold" BorderThickness="0" Margin="10,0,5,0"/>
            <Button Content="Properties" Width="100" Height="40" Background="Transparent" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>

        <!-- အလယ်ပိုင်း Main Content Area (View များကို ဖလှယ်ပြသရန်) -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentView}"/>

        <!-- အောက်ဆုံး Status Bar -->
        <StatusBar Grid.Row="3" Background="#E0E0E0">
            <StatusBarItem Content="Printer Queue Status: Ready"/>
        </StatusBar>
    </Grid>
</Window>
