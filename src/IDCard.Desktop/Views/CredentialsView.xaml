<UserControl x:Class="IDCard.Desktop.Views.CredentialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Background="White">
        <!-- Window ၏ ညာဘက်ဘေးတွင် Vertical Scrollbar အလိုအလျောက် ပေါ်လာစေရန် ScrollViewer သုံးထားသည် -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="15">
                
                <!-- Top View Toggle Buttons (Grid View & List View Icons) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <!-- Grid View Button -->
                    <Button Command="{Binding SwitchToGridViewCommand}" Width="35" Height="30" Margin="0,0,5,0" ToolTip="Grid View" Background="#E0E0E0" BorderBrush="#CCCCCC">
                        <TextBlock Text="🧮" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    
                    <!-- List View Button -->
                    <Button Command="{Binding SwitchToListViewCommand}" Width="35" Height="30" ToolTip="List View" Background="#E0E0E0" BorderBrush="#CCCCCC">
                        <TextBlock Text="☰" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Dynamic Content Area (View Mode အလိုက် ပြောင်းလဲပြသရန်) -->
                <ContentControl Content="{Binding CurrentViewContent}">
                    <ContentControl.Resources>
                        
                        <!-- 1. Grid View Template (ကွက်တိ ပုံစံပြသရန်) -->
                        <DataTemplate x:Key="GridViewTemplate">
                            <WrapPanel ItemsSource="{Binding CardDesigns}">
                                <!-- Card Item UI Design များကို ဤနေရာတွင် ထည့်သွင်းနိုင်သည် -->
                            </WrapPanel>
                        </DataTemplate>

                        <!-- 2. List View Template (ဇယားကွက် ပုံစံပြသရန်) -->
                        <DataTemplate x:Key="ListViewTemplate">
                            <ListView ItemsSource="{Binding CardDesigns}" Height="350" BorderBrush="#E0E0E0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Credential Design Name" Width="250" DisplayMemberBinding="{Binding DesignName}"/>
                                        <GridViewColumn Header="Owner Name" Width="180" DisplayMemberBinding="{Binding OwnerUsername}"/>
                                        <GridViewColumn Header="Actions" Width="120"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DataTemplate>

                    </ContentControl.Resources>
                </ContentControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
