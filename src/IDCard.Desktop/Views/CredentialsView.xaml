<UserControl x:Class="IDCard.Desktop.Views.CredentialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
             Background="#F3F4F6">
             
    <UserControl.DataContext>
        <vm:CredentialsViewModel/>
    </UserControl.DataContext>

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="Credentials Management" FontSize="22" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,15"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="#4B5563"/>
        </StackPanel>
    </Grid>
</UserControl>
