<UserControl x:Class="IDCard.Desktop.Views.CredentialDesignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Stable Button Style with CornerRadius -->
        <Style x:Key="StableButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- CheckBox Style to Ensure Visible Border -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <!-- ၁။ ပထမဦးဆုံးပေါ်ရမည့် မျက်နှာပြင်: "Create New Credential" ခလုတ် -->
        <Grid Margin="20,20,20,20">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditingCredential}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Button Content="Create New Credential" 
                        Command="{Binding CreateNewCredentialCommand}"
                        Style="{StaticResource StableButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ၂။ "Create New Credential" ကို နှိပ်မှ ပေါ်လာမည့် Credential Designer မျက်နှာပြင် -->
        <Grid Background="#E0E0E0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditingCredential}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- အပေါ်ဆုံး Toolbar -->
            <Border Grid.Row="0" Background="#EFEFEF" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↶" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Undo"/>
                    <Button Content="↷" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Redo"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="📋" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Copy"/>
                    <Button Content="✂" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Cut"/>
                    <Button Content="📄" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Paste"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="T₁" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Static Text" FontWeight="Bold"/>
                    <Button Content="T₂" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Dynamic Text" FontWeight="Bold"/>
                    <Button Content="👤" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Portrait"/>
                    <Button Content="🖼" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Image"/>
                    <Button Content="🔄" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Dynamic Image"/>
                    <Button Content="📊" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Table"/>
                    <Button Content="📈" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Chart"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="IIII" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Barcode" FontWeight="Bold"/>
                    <Button Content="💳" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Magnetic Stripe"/>
                    <Button Content="🖨" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Smart Card"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="╱" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Line"/>
                    <Button Content="⬜" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Rectangle"/>
                    <Button Content="⭕" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Ellipse"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="📏" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Ruler"/>
                    <Button Content="🔲" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Grid"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="🔍+" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Zoom In"/>
                    <Button Content="🔍-" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Zoom Out"/>
                </StackPanel>
            </Border>

            <!-- အလယ်ပိုင်း Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="15">
                    <StackPanel>
                        <!-- Top Labels Layout (Front Side & Active Design Layer aligned to right) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="445"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Front Side" FontWeight="Bold" FontSize="13" Margin="0,0,15,0"/>
                                    <TextBlock FontWeight="Bold" FontSize="13" Foreground="#333333">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Text" Value="Active Design Layer: Color"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Back Side" FontWeight="Bold" FontSize="13" Margin="0,0,20,0"/>
                                <TextBlock FontWeight="Bold" FontSize="13" Foreground="#333333">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Text" Value="Active Design Layer: Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Side-by-Side Canvases with Selection Support -->
                        <StackPanel Orientation="Horizontal">
                            <!-- Front Side Outer Border -->
                            <Border Background="#9E9E9E" Height="380" Width="425" Margin="0,0,20,0" CornerRadius="4" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectFrontSideCommand}"/>
                                </Border.InputBindings>
                                <Border Background="White" Width="280" Height="180" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSide}" Value="Front">
                                                    <Setter Property="BorderBrush" Value="Black"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>

                            <!-- Back Side Outer Border -->
                            <Border Background="#9E9E9E" Height="380" Width="425" CornerRadius="4" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectBackSideCommand}"/>
                                </Border.InputBindings>
                                <Border Background="White" Width="280" Height="180" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                    <Setter Property="BorderBrush" Value="Black"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Properties Panel -->
                <Border Grid.Column="1" Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Padding="15">
                    <StackPanel>
                        <!-- Properties / Layers Tab Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="Properties" Width="120" Height="30" Command="{Binding ShowPropertiesTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                        <Setter Property="Foreground" Value="#555555"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLayersTabSelected}" Value="False">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#333333"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Layers" Width="120" Height="30" Command="{Binding ShowLayersTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                        <Setter Property="Foreground" Value="#555555"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                        <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLayersTabSelected}" Value="True">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#333333"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Properties Panel Content -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2" Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLayersTabSelected}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Border Background="#EFEFEF" Padding="10,8" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                                    <TextBlock FontWeight="SemiBold" Foreground="#222222" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Front Side Properties"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                        <Setter Property="Text" Value="Back Side Properties"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Margin="12,12,12,14">
                                    <CheckBox IsChecked="{Binding RotatePrintOrientation180}" Margin="0,0,0,12" VerticalContentAlignment="Top" Cursor="Hand">
                                        <TextBlock Text="Rotate print orientation 180 degrees" TextWrapping="Wrap" Width="190" Foreground="#333333"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding TactileImpressionModule}" VerticalContentAlignment="Center" Cursor="Hand">
                                        <TextBlock Text="Tactile Impression Module" Foreground="#333333" VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Layers Panel Content -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2" Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLayersTabSelected}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Border Background="#EFEFEF" Padding="10,8" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Front Side" FontWeight="Bold" Foreground="#333333" FontSize="13"/>
                                </Border>

                                <StackPanel>
                                    <Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="All layers" Foreground="#222222" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="#EEEEEE"/>
                                    <Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Background" Foreground="#333333" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="#EEEEEE"/>
                                    <Border Background="#B0C4DE"><Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#002D62" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Color" Foreground="#111111" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" IsChecked="True" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border>
                                    <Border Height="1" Background="#EEEEEE"/>
                                    <Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Black" Foreground="#333333" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="#EEEEEE"/>
                                    <Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Topcoat" Foreground="#333333" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" IsChecked="True" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="#EEEEEE"/>
                                    <Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Retransfer Material" Foreground="#333333" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="#EEEEEE"/>
                                    <Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Luster/Fluorescent" Foreground="#333333" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="#EEEEEE"/>
                                    <Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Non-printable area" Foreground="#333333" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="#EEEEEE"/>
                                    <Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Lamination" Foreground="#333333" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="#EEEEEE"/>
                                    <Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Emboss or indent" Foreground="#333333" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="#EEEEEE"/>
                                    <Grid Height="28" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="👁" FontSize="11" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Magnetic stripe" Foreground="#333333" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="12"/><CheckBox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- အောက်ဆုံး Buttons -->
            <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                <Border Padding="15,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Save" Style="{StaticResource StableButtonStyle}" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Save As..." Style="{StaticResource StableButtonStyle}" Background="#757575" Width="90" Margin="0,0,10,0"/>
                        <Button Content="Close" 
                                Command="{Binding CloseCredentialCommand}"
                                Style="{StaticResource StableButtonStyle}" Background="#B0BEC5" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Print Sample" Style="{StaticResource StableButtonStyle}" Background="#757575" Width="100"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
