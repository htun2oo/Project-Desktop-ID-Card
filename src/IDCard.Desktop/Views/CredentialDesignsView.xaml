<UserControl x:Class="IDCard.Desktop.Views.CredentialDesignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="StableButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <!-- ၁။ ပထမဦးဆုံးပေါ်ရမည့် မျက်နှာပြင်: "Create New Credential" ခလုတ် -->
        <Grid Margin="20,20,20,20">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditingCredential}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Button Content="Create New Credential" 
                        Command="{Binding CreateNewCredentialCommand}"
                        Style="{StaticResource StableButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ၂။ "Create New Credential" ကို နှိပ်မှ ပေါ်လာမည့် Credential Designer မျက်နှာပြင် -->
        <Grid Background="#E0E0E0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditingCredential}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- အပေါ်ဆုံး Toolbar -->
            <Border Grid.Row="0" Background="#EFEFEF" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↶" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Undo"/>
                    <Button Content="↷" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Redo"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="📋" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Copy"/>
                    <Button Content="✂" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Cut"/>
                    <Button Content="📄" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Paste"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="T₁" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Static Text" FontWeight="Bold"/>
                    <Button Content="T₂" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Dynamic Text" FontWeight="Bold"/>
                    <Button Content="👤" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Portrait"/>
                    <Button Content="🖼" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Image"/>
                    <Button Content="🔄" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Dynamic Image"/>
                    <Button Content="📊" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Table"/>
                    <Button Content="📈" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Chart"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="IIII" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Barcode" FontWeight="Bold"/>
                    <Button Content="💳" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Magnetic Stripe"/>
                    <Button Content="🖨" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Smart Card"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="╱" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Line"/>
                    <Button Content="⬜" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Rectangle"/>
                    <Button Content="⭕" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Ellipse"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="📏" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Ruler"/>
                    <Button Content="🔲" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Grid"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="🔍+" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Zoom In"/>
                    <Button Content="🔍-" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Zoom Out"/>
                </StackPanel>
            </Border>

            <!-- အလယ်ပိုင်း Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="15">
                    <StackPanel>
                        <TextBlock Text="Front Side" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Border Background="#9E9E9E" Height="300" Width="450" Margin="0,0,0,20" CornerRadius="4">
                            <Border Background="White" Width="320" Height="200" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Back Side" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Border Background="#9E9E9E" Height="300" Width="450" CornerRadius="4">
                            <Border Background="White" Width="320" Height="200" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Background="#EFEFEF" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Padding="15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="Properties" Width="120" Height="30" Background="White" Foreground="#333333" FontWeight="Bold" BorderBrush="#CCCCCC" BorderThickness="1"/>
                            <Button Content="Layers" Width="120" Height="30" Background="#E0E0E0" Foreground="#555555" FontWeight="SemiBold" BorderBrush="#CCCCCC" BorderThickness="1,1,1,1"/>
                        </StackPanel>

                        <Expander Header="Front Side Properties" IsExpanded="True" FontWeight="SemiBold" Foreground="#333333">
                            <StackPanel Margin="0,10,0,0">
                                <CheckBox Content="Rotate print orientation 180 degrees" Margin="0,0,0,8" FontWeight="Normal"/>
                                <CheckBox Content="Tactile Impression Module" FontWeight="Normal"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- အောက်ဆုံး Buttons -->
            <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                <Border Padding="15,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Save" Style="{StaticResource StableButtonStyle}" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Save As..." Style="{StaticResource StableButtonStyle}" Background="#757575" Width="90" Margin="0,0,10,0"/>
                        <Button Content="Close" 
                                Command="{Binding CloseCredentialCommand}"
                                Style="{StaticResource StableButtonStyle}" Background="#B0BEC5" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Print Sample" Style="{StaticResource StableButtonStyle}" Background="#757575" Width="100"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Edit Properties Dialog Overlay -->
        <Grid Background="#66000000" Panel.ZIndex="100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditPropertiesOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="White" Width="420" Height="580" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#6A1B9A" CornerRadius="6,6,0,0">
                        <Grid Margin="15,0">
                            <TextBlock Text="Edit Properties" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="✕" Command="{Binding CloseEditPropertiesCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,15">
                        <StackPanel>
                            <TextBlock Text="Name" Foreground="#333333" Margin="0,0,0,5"/>
                            <TextBox Text="Credential Design 1" Height="30" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15" BorderBrush="#CCCCCC"/>

                            <TextBlock Text="Dimensions" Foreground="#333333" Margin="0,0,0,5"/>
                            <ComboBox Height="30" SelectedIndex="0" Margin="0,0,0,15">
                                <ComboBoxItem Content="ISO ID-1"/>
                            </ComboBox>

                            <TextBlock Text="Units" Foreground="#333333" Margin="0,0,0,5"/>
                            <ComboBox Height="30" SelectedIndex="0" Margin="0,0,0,15">
                                <ComboBoxItem Content="Centimeters"/>
                                <ComboBoxItem Content="Inches"/>
                            </ComboBox>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width" Foreground="#333333" Margin="0,0,0,5"/>
                                    <TextBox Text="8.5725" Height="30" VerticalContentAlignment="Center" Padding="5,0" BorderBrush="#CCCCCC"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height" Foreground="#333333" Margin="0,0,0,5"/>
                                    <TextBox Text="5.3975" Height="30" VerticalContentAlignment="Center" Padding="5,0" BorderBrush="#CCCCCC"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Rewritable credential" Margin="0,0,0,10"/>
                            <CheckBox Content="Print over the edge" Margin="0,0,0,15"/>

                            <TextBlock Text="Description" Foreground="#333333" Margin="0,0,0,5"/>
                            <TextBox Height="80" AcceptsReturn="True" TextWrapping="Wrap" Padding="5" BorderBrush="#CCCCCC"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" CornerRadius="0,0,6,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0">
                            <Button Content="OK" Command="{Binding CloseEditPropertiesCommand}" Style="{StaticResource StableButtonStyle}" Width="80" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Command="{Binding CloseEditPropertiesCommand}" Style="{StaticResource StableButtonStyle}" Background="#E0E0E0" Foreground="#333333" Width="80"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
