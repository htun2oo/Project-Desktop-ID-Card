<UserControl x:Class="IDCard.Desktop.Views.CredentialDesignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Stable Button Style with CornerRadius -->
        <Style x:Key="StableButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- CheckBox Style to Ensure Visible Border -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <!-- ၁။ ပထမဦးဆုံးပေါ်ရမည့် မျက်နှာပြင်: "Create New Credential" ခလုတ် -->
        <Grid Margin="20,20,20,20">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditingCredential}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Button Content="Create New Credential" 
                        Command="{Binding CreateNewCredentialCommand}"
                        Style="{StaticResource StableButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ၂။ "Create New Credential" ကို နှိပ်မှ ပေါ်လာမည့် Credential Designer မျက်နှာပြင် -->
        <Grid Background="#E0E0E0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditingCredential}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- အပေါ်ဆုံး Toolbar -->
            <Border Grid.Row="0" Background="#EFEFEF" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↶" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Undo"/>
                    <Button Content="↷" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Redo"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="📋" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Copy"/>
                    <Button Content="✂" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Cut"/>
                    <Button Content="📄" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Paste"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="T₁" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Static Text" FontWeight="Bold"/>
                    <Button Content="T₂" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Dynamic Text" FontWeight="Bold"/>
                    <Button Content="👤" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Portrait"/>
                    <Button Content="🖼" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Image"/>
                    <Button Content="🔄" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Dynamic Image"/>
                    <Button Content="📊" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Table"/>
                    <Button Content="📈" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Chart"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="IIII" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Barcode" FontWeight="Bold"/>
                    <Button Content="💳" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Magnetic Stripe"/>
                    <Button Content="🖨" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Smart Card"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="╱" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Line"/>
                    <Button Content="⬜" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Rectangle"/>
                    <Button Content="⭕" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Ellipse"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="📏" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Ruler"/>
                    <Button Content="🔲" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Grid"/>
                    <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                    <Button Content="🔍+" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Zoom In"/>
                    <Button Content="🔍-" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Zoom Out"/>
                </StackPanel>
            </Border>

            <!-- အလယ်ပိုင်း Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="15">
                    <StackPanel>
                        <!-- Top Labels Layout -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="370"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Front Side" FontWeight="Bold" FontSize="13" Margin="0,0,20,0"/>
                                <TextBlock FontWeight="Bold" FontSize="13" Foreground="#333333">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="Active Design Layer: Color"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Back Side" FontWeight="Bold" FontSize="13" Margin="0,0,20,0"/>
                                <TextBlock FontWeight="Bold" FontSize="13" Foreground="#333333">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Text" Value="Active Design Layer: Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Side-by-Side Canvases with Selection Support -->
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#9E9E9E" Height="380" Width="350" Margin="0,0,20,0" CornerRadius="4" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectFrontSideCommand}"/>
                                </Border.InputBindings>
                                <Border Background="White" Width="280" Height="180" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSide}" Value="Front">
                                                    <Setter Property="BorderBrush" Value="Black"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>

                            <Border Background="#9E9E9E" Height="380" Width="350" CornerRadius="4" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectBackSideCommand}"/>
                                </Border.InputBindings>
                                <Border Background="White" Width="280" Height="180" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                    <Setter Property="BorderBrush" Value="Black"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Properties Panel -->
                <Border Grid.Column="1" Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Padding="15">
                    <StackPanel>
                        <!-- Properties / Layers Tab Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="Properties" Width="120" Height="30" Background="White" Foreground="#333333" FontWeight="Bold" BorderBrush="#CCCCCC" BorderThickness="1"/>
                            <Button Content="Layers" Width="120" Height="30" Background="#E0E0E0" Foreground="#555555" FontWeight="SemiBold" BorderBrush="#CCCCCC" BorderThickness="1,1,1,1"/>
                        </StackPanel>

                        <!-- Custom Box Container with Visible Checkboxes and Texts -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2" Background="White">
                            <StackPanel>
                                <!-- Header Bar with Gray Background -->
                                <Border Background="#EFEFEF" Padding="10,8" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="–" FontWeight="Bold" FontSize="14" Foreground="#333333" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock FontWeight="SemiBold" Foreground="#222222" FontSize="13" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Front Side Properties"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                            <Setter Property="Text" Value="Back Side Properties"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Content Panel with Checkboxes and Visible Text -->
                                <StackPanel Margin="12,12,12,14">
                                    <CheckBox IsChecked="{Binding RotatePrintOrientation180}" Margin="0,0,0,12" VerticalContentAlignment="Top" Cursor="Hand">
                                        <TextBlock Text="Rotate print orientation 180 degrees" TextWrapping="Wrap" Width="190" Foreground="#333333"/>
                                    </CheckBox>
                                    
                                    <CheckBox IsChecked="{Binding TactileImpressionModule}" VerticalContentAlignment="Center" Cursor="Hand">
                                        <TextBlock Text="Tactile Impression Module" Foreground="#333333" VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- အောက်ဆုံး Buttons -->
            <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                <Border Padding="15,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Save" Style="{StaticResource StableButtonStyle}" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Save As..." Style="{StaticResource StableButtonStyle}" Background="#757575" Width="90" Margin="0,0,10,0"/>
                        <Button Content="Close" 
                                Command="{Binding CloseCredentialCommand}"
                                Style="{StaticResource StableButtonStyle}" Background="#B0BEC5" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Print Sample" Style="{StaticResource StableButtonStyle}" Background="#757575" Width="100"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Edit Properties Dialog Overlay -->
        <Canvas x:Name="ParentCanvas" Background="#66000000" Panel.ZIndex="999" ClipToBounds="False"
                Grid.RowSpan="3">
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditPropertiesOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>

            <Border x:Name="DialogBorder" Background="White" Width="420" Height="580" CornerRadius="6" 
                    Canvas.Left="390" Canvas.Top="60">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <!-- Draggable Header with Fully Visible Close Button -->
                    <Border x:Name="HeaderBorder" Grid.Row="0" Background="#6A1B9A" CornerRadius="6,6,0,0"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown"
                            MouseMove="Header_MouseMove"
                            MouseLeftButtonUp="Header_MouseLeftButtonUp"
                            Cursor="SizeAll">
                        <Grid Margin="15,0">
                            <TextBlock Text="Edit Properties" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Button Content="✕" Command="{Binding CloseEditPropertiesCommand}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Center" 
                                    Width="30" Height="30" Background="Transparent" 
                                    Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="14"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,15">
                        <StackPanel>
                            <!-- Name -->
                            <TextBlock Text="Name" Foreground="#333333" Margin="0,0,0,5"/>
                            <TextBox Text="Credential Design 1" 
                                   Width="300" 
                                   HorizontalAlignment="Left"
                                   Height="30" 
                                   VerticalContentAlignment="Center" 
                                   Padding="5,0" 
                                   Margin="0,0,0,15" 
                                   Background="White"
                                   Foreground="#333333"
                                   BorderBrush="#CCCCCC"
                                   SelectionBrush="#1E88E5"/>

                            <!-- Dimensions & Units -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <StackPanel Width="180">
                                    <TextBlock Text="Dimensions" Foreground="#333333" Margin="0,0,0,5"/>
                                    <ComboBox Height="30" 
                                              SelectedIndex="0" 
                                              Background="White"
                                              Foreground="#333333"
                                              BorderBrush="#CCCCCC"
                                              BorderThickness="1">
                                        <ComboBoxItem Content="ISO ID-1"/>
                                        <ComboBoxItem Content="CR-50"/>
                                        <ComboBoxItem Content="Custom"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <StackPanel Width="180" Margin="-40,0,0,0">
                                    <TextBlock Text="Units" Foreground="#333333" Margin="0,0,0,5"/>
                                    <!-- Centimeters = Index 0, Inches = Index 1 -->
                                    <ComboBox x:Name="UnitsComboBox" Height="30" 
                                              SelectedIndex="0" 
                                              Background="White"
                                              Foreground="#333333"
                                              BorderBrush="#CCCCCC"
                                              BorderThickness="1">
                                        <ComboBoxItem Content="Centimeters"/>
                                        <ComboBoxItem Content="Inches"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Width & Height (Corrected DataTriggers matching Index 0 for cm and Index 1 for inches) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <StackPanel Width="180">
                                    <TextBlock Text="Width" Foreground="#333333" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Width TextBox -->
                                        <TextBox x:Name="WidthTextBox" Grid.Column="0" Width="60" HorizontalAlignment="Left" Height="30" VerticalContentAlignment="Center" Padding="5,0" Background="White" Foreground="#333333" BorderBrush="#CCCCCC">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <!-- Default (Centimeters - Index 0) -->
                                                    <Setter Property="Text" Value="8.5725"/>
                                                    <Style.Triggers>
                                                        <!-- Centimeters (Index 0): Width = 8.5725 -->
                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=UnitsComboBox}" Value="0">
                                                            <Setter Property="Text" Value="8.5725"/>
                                                        </DataTrigger>
                                                        <!-- Inches (Index 1): Width = 3.3750 -->
                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=UnitsComboBox}" Value="1">
                                                            <Setter Property="Text" Value="3.3750"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        
                                        <!-- Width Unit Label -->
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#333333" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="cm"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=UnitsComboBox}" Value="0">
                                                            <Setter Property="Text" Value="cm"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=UnitsComboBox}" Value="1">
                                                            <Setter Property="Text" Value="inches"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                                
                                <StackPanel Width="180" Margin="-40,0,0,0">
                                    <TextBlock Text="Height" Foreground="#333333" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Height TextBox -->
                                        <TextBox x:Name="HeightTextBox" Grid.Column="0" Width="60" HorizontalAlignment="Left" Height="30" VerticalContentAlignment="Center" Padding="5,0" Background="White" Foreground="#333333" BorderBrush="#CCCCCC">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <!-- Default (Centimeters - Index 0) -->
                                                    <Setter Property="Text" Value="5.3975"/>
                                                    <Style.Triggers>
                                                        <!-- Centimeters (Index 0): Height = 5.3975 -->
                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=UnitsComboBox}" Value="0">
                                                            <Setter Property="Text" Value="5.3975"/>
                                                        </DataTrigger>
                                                        <!-- Inches (Index 1): Height = 2.1250 -->
                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=UnitsComboBox}" Value="1">
                                                            <Setter Property="Text" Value="2.1250"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        
                                        <!-- Height Unit Label -->
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#333333" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="cm"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=UnitsComboBox}" Value="0">
                                                            <Setter Property="Text" Value="cm"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=UnitsComboBox}" Value="1">
                                                            <Setter Property="Text" Value="inches"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- Checkboxes with Help Icons -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                <CheckBox Content="Rewritable credential" VerticalContentAlignment="Center"/>
                                <Border Width="16" Height="16" Background="#2196F3" CornerRadius="8" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                    <TextBlock Text="?" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                                <CheckBox Content="Print over the edge" VerticalContentAlignment="Center"/>
                                <Border Width="16" Height="16" Background="#2196F3" CornerRadius="8" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                    <TextBlock Text="?" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Description -->
                            <TextBlock Text="Description" Foreground="#333333" Margin="0,0,0,5"/>
                            <TextBox Height="80" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap" 
                                     Padding="5" 
                                     Background="White" 
                                     Foreground="#333333" 
                                     BorderBrush="#CCCCCC"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" CornerRadius="0,0,6,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0">
                            <Button Content="OK" Command="{Binding CloseEditPropertiesCommand}" Style="{StaticResource StableButtonStyle}" Width="80" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Command="{Binding CloseEditPropertiesCommand}" Style="{StaticResource StableButtonStyle}" Background="#E0E0E0" Foreground="#333333" Width="80"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
