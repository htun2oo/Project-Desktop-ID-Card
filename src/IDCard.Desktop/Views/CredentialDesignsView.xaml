<UserControl x:Class="IDCard.Desktop.Views.CredentialDesignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="StableButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <!-- ၁။ ပထမဦးဆုံးပေါ်ရမည့် မျက်နှာပြင်: "Create New Credential" ခလုတ် -->
        <Grid Margin="20,20,20,20">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditingCredential}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Button Content="Create New Credential" 
                        Command="{Binding CreateNewCredentialCommand}"
                        Style="{StaticResource StableButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ၂။ "Create New Credential" ကို နှိပ်မှ ပေါ်လာမည့် Credential Designer မျက်နှာပြင် -->
        <Grid Background="#E0E0E0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditingCredential}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- အပေါ်ဆုံး Toolbar -->
            <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↶" Width="30" Height="28" Margin="2,0" ToolTip="Undo"/>
                    <Button Content="↷" Width="30" Height="28" Margin="2,0" ToolTip="Redo"/>
                    <Rectangle Width="1" Height="20" Fill="#CCCCCC" Margin="8,0"/>
                    <Button Content="T" Width="30" Height="28" Margin="2,0" FontWeight="Bold" ToolTip="Text"/>
                    <Button Content="🖹" Width="30" Height="28" Margin="2,0" ToolTip="Image"/>
                    <Button Content="⬜" Width="30" Height="28" Margin="2,0" ToolTip="Shape"/>
                    <Button Content="🔍" Width="30" Height="28" Margin="2,0" ToolTip="Zoom"/>
                </StackPanel>
            </Border>

            <!-- အလယ်ပိုင်း Main Content Area (Front/Back Side Canvases နှင့် Properties) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="15">
                    <StackPanel>
                        <TextBlock Text="Front Side" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Border Background="#9E9E9E" Height="300" Width="450" Margin="0,0,0,20" CornerRadius="4">
                            <Border Background="White" Width="320" Height="200" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Back Side" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Border Background="#9E9E9E" Height="300" Width="450" CornerRadius="4">
                            <Border Background="White" Width="320" Height="200" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Background="#EFEFEF" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Padding="15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="Properties" Width="120" Height="30" Background="White" Foreground="#333333" FontWeight="Bold" BorderBrush="#CCCCCC" BorderThickness="1"/>
                            <Button Content="Layers" Width="120" Height="30" Background="#E0E0E0" Foreground="#555555" FontWeight="SemiBold" BorderBrush="#CCCCCC" BorderThickness="1,1,1,1"/>
                        </StackPanel>

                        <Expander Header="Front Side Properties" IsExpanded="True" FontWeight="SemiBold" Foreground="#333333">
                            <StackPanel Margin="0,10,0,0">
                                <CheckBox Content="Rotate print orientation 180 degrees" Margin="0,0,0,8" FontWeight="Normal"/>
                                <CheckBox Content="Tactile Impression Module" FontWeight="Normal"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- အောက်ဆုံး Buttons -->
            <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                <Border Padding="15,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Save" Style="{StaticResource StableButtonStyle}" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Save As..." Style="{StaticResource StableButtonStyle}" Background="#757575" Width="90" Margin="0,0,10,0"/>
                        <Button Content="Close" 
                                Command="{Binding CloseCredentialCommand}"
                                Style="{StaticResource StableButtonStyle}" Background="#B0BEC5" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Print Sample" Style="{StaticResource StableButtonStyle}" Background="#757575" Width="100"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
