<UserControl x:Class="IDCard.Desktop.Views.CredentialDesignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="StableButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Standard Clickable ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBoxItem Style to Ensure Visible Text in Dropdown -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1E88E5"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E88E5"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Parent Canvas for Dialog & Dragging Support -->
    <Canvas x:Name="ParentCanvas">
        <Grid Background="White" Width="{Binding ActualWidth, ElementName=ParentCanvas}" Height="{Binding ActualHeight, ElementName=ParentCanvas}">
            <!-- ၁။ Create New Credential Screen -->
            <Grid Margin="20,20,20,20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingCredential}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Button Content="Create New Credential" 
                            Command="{Binding CreateNewCredentialCommand}"
                            Style="{StaticResource StableButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ၂။ Credential Designer Screen -->
            <Grid Background="#E0E0E0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingCredential}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Background="#EFEFEF" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↶" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Undo"/>
                        <Button Content="↷" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Redo"/>
                        <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                        <Button Content="📋" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Copy"/>
                        <Button Content="✂" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Cut"/>
                        <Button Content="📄" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Paste"/>
                        <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                        
                        <Button Content="T₁" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Dynamic Text" FontWeight="Bold"
                                PreviewMouseLeftButtonDown="ToolBarButton_PreviewMouseLeftButtonDown"/>
                        <Button Content="T₂" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Static Text" FontWeight="Bold"
                                PreviewMouseLeftButtonDown="ToolBarButton_PreviewMouseLeftButtonDown"/>
                        <Button Content="👤" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Photo"
                                PreviewMouseLeftButtonDown="ToolBarButton_PreviewMouseLeftButtonDown"/>
                        <Button Content="🖼" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Static Graphic"
                                PreviewMouseLeftButtonDown="ToolBarButton_PreviewMouseLeftButtonDown"/>
                        <Button Content="🔄" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Variable Graphic"
                                PreviewMouseLeftButtonDown="ToolBarButton_PreviewMouseLeftButtonDown"/>
                        <Button Content="📊" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Date"
                                PreviewMouseLeftButtonDown="ToolBarButton_PreviewMouseLeftButtonDown"/>
                        <Button Content="📈" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Signature"
                                PreviewMouseLeftButtonDown="ToolBarButton_PreviewMouseLeftButtonDown"/>
                        
                        <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="4,0"/>
                        
                        <Button Content="IIII" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Bar Code" FontWeight="Bold"
                                PreviewMouseLeftButtonDown="ToolBarButton_PreviewMouseLeftButtonDown"/>
                        <Button Content="💳" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Magnetic Stripe"/>
                        <Button Content="🖨" Style="{StaticResource ToolBarButtonStyle}" ToolTip="Smart Card"/>
                    </StackPanel>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="15">
                        <StackPanel>
                            <!-- Top Labels Layout -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="425"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="425"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBlock Text="Front Side" FontWeight="Bold" FontSize="13" HorizontalAlignment="Left"/>
                                    <TextBlock FontWeight="Bold" FontSize="13" Foreground="#333333" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Text" Value="Active Design Layer: Color"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <TextBlock Text="Back Side" FontWeight="Bold" FontSize="13" HorizontalAlignment="Left"/>
                                    <TextBlock FontWeight="Bold" FontSize="13" Foreground="#333333" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Text" Value="Active Design Layer: Black"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>

                            <!-- Side-by-Side Canvases with Drag & Drop Support -->
                            <StackPanel Orientation="Horizontal">
                                <!-- Front Side Drop Area -->
                                <Border Background="#9E9E9E" Height="380" Width="425" Margin="0,0,20,0" CornerRadius="4" Cursor="Hand"
                                        AllowDrop="True" Drop="Canvas_Drop">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectFrontSideCommand}"/>
                                    </Border.InputBindings>
                                    <Border Background="White" Width="280" Height="180" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MouseDown="CardBackground_MouseDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSide}" Value="Front">
                                                        <Setter Property="BorderBrush" Value="Black"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Canvas>
                                            <!-- Text Elements -->
                                            <ItemsControl ItemsSource="{Binding FrontSideElements}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent" Padding="4" Margin="30,40,0,0"
                                                                MouseLeftButtonDown="TextElement_MouseLeftButtonDown" Cursor="Hand">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#1E88E5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="Black"/>
                                                                <Grid>
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <Ellipse Width="6" Height="6" Fill="Blue" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
                                                                    <Ellipse Width="6" Height="6" Fill="Blue" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-6,0,0,0"/>
                                                                    <Ellipse Width="6" Height="6" Fill="Blue" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,-6,0"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </Border>
                                </Border>

                                <!-- Back Side Drop Area -->
                                <Border Background="#9E9E9E" Height="380" Width="425" CornerRadius="4" Cursor="Hand"
                                        AllowDrop="True" Drop="Canvas_Drop">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectBackSideCommand}"/>
                                    </Border.InputBindings>
                                    <Border Background="White" Width="280" Height="180" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MouseDown="CardBackground_MouseDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                        <Setter Property="BorderBrush" Value="Black"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Canvas>
                                            <ItemsControl ItemsSource="{Binding BackSideElements}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent" Padding="4" Margin="30,40,0,0"
                                                                MouseLeftButtonDown="TextElement_MouseLeftButtonDown" Cursor="Hand">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#1E88E5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="Black"/>
                                                                <Grid>
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <Ellipse Width="6" Height="6" Fill="Blue" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
                                                                    <Ellipse Width="6" Height="6" Fill="Blue" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-6,0,0,0"/>
                                                                    <Ellipse Width="6" Height="6" Fill="Blue" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,-6,0"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right Properties & Layers Panel -->
                    <Border Grid.Column="1" Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Button Content="Properties" Width="120" Height="30" 
                                            Command="{Binding ShowPropertiesTabCommand}"
                                            FontWeight="Bold" BorderBrush="#CCCCCC" BorderThickness="1">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                <Setter Property="Foreground" Value="#555555"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLayersTabSelected}" Value="False">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#333333"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Layers" Width="120" Height="30" 
                                            Command="{Binding ShowLayersTabCommand}"
                                            FontWeight="SemiBold" BorderBrush="#CCCCCC" BorderThickness="1,1,1,1">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                <Setter Property="Foreground" Value="#555555"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLayersTabSelected}" Value="True">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#333333"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Properties View -->
                                <Border x:Name="DialogBorder" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2" Background="White" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLayersTabSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        
                                        <!-- 1. Unselected State: Front/Back Side Properties (Rotate & Tactile) -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTextSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Border Background="#EFEFEF" Padding="10,8" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="–" FontWeight="Bold" FontSize="14" Foreground="#333333" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock FontWeight="SemiBold" Foreground="#222222" FontSize="13" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Front Side Properties"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedSide}" Value="Back">
                                                                        <Setter Property="Text" Value="Back Side Properties"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Margin="12,12,12,14">
                                                <CheckBox Margin="0,0,0,12" VerticalContentAlignment="Top" Cursor="Hand">
                                                    <TextBlock Text="Rotate print orientation 180 degrees" TextWrapping="Wrap" Width="190" Foreground="#333333"/>
                                                </CheckBox>
                                                <CheckBox VerticalContentAlignment="Center" Cursor="Hand">
                                                    <TextBlock Text="Tactile Impression Module" Foreground="#333333" VerticalAlignment="Center"/>
                                                </CheckBox>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 2. Selected State: Dynamic Text Field Selected (General & Appearance) -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTextSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <!-- General Section -->
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                                                <Button Command="{Binding ToggleGeneralCommand}" Background="#EFEFEF" Padding="10,8" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                    <TextBlock FontWeight="Bold" FontSize="12" Foreground="#333333" HorizontalAlignment="Left">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="+ General"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGeneralExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="- General"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <!-- General Expanded Inputs -->
                                                <StackPanel Margin="10" Orientation="Vertical" HorizontalAlignment="Stretch">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGeneralExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock Text="Field name" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBox Text="Text Field 1" Height="28" Margin="0,0,0,10" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Background="White" Foreground="Black" BorderBrush="#CCCCCC"/>

                                                    <TextBlock Text="Sample data" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBox Text="Text Field" Height="28" Margin="0,0,0,10" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Background="White" Foreground="Black" BorderBrush="#CCCCCC"/>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Alignment" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                            <ComboBox HorizontalAlignment="Stretch">
                                                                <ComboBoxItem IsSelected="True">
                                                                    <TextBlock Text="Left" Foreground="Black"/>
                                                                </ComboBoxItem>
                                                                <ComboBoxItem>
                                                                    <TextBlock Text="Center" Foreground="Black"/>
                                                                </ComboBoxItem>
                                                                <ComboBoxItem>
                                                                    <TextBlock Text="Right" Foreground="Black"/>
                                                                </ComboBoxItem>
                                                                <ComboBoxItem>
                                                                    <TextBlock Text="Distribute" Foreground="Black"/>
                                                                </ComboBoxItem>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Rotation" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="0" Height="28" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Background="White" Foreground="Black" BorderBrush="#CCCCCC"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Position: Left" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="0.1813" Height="28" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Background="White" Foreground="Black" BorderBrush="#CCCCCC"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Position: Top" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="0.4474" Height="28" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Background="White" Foreground="Black" BorderBrush="#CCCCCC"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Width" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="1" Height="28" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Background="White" Foreground="Black" BorderBrush="#CCCCCC"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Height" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="0.2083" Height="28" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Background="White" Foreground="Black" BorderBrush="#CCCCCC"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <CheckBox Content="Automatically adjust the font size" FontSize="11" Foreground="#333333" Margin="0,5,0,0" Cursor="Hand"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Appearance Section -->
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                                                <Button Command="{Binding ToggleAppearanceCommand}" Background="#EFEFEF" Padding="10,8" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                    <TextBlock FontWeight="Bold" FontSize="12" Foreground="#333333" HorizontalAlignment="Left">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="+ Appearance"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAppearanceExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="- Appearance"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <!-- Appearance Expanded Inputs -->
                                                <StackPanel Margin="10" Orientation="Vertical" HorizontalAlignment="Stretch">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAppearanceExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock Text="Font family" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                    <ComboBox Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem IsSelected="True">
                                                            <TextBlock Text="Arial" Foreground="Black"/>
                                                        </ComboBoxItem>
                                                        <ComboBoxItem>
                                                            <TextBlock Text="Segoe UI" Foreground="Black"/>
                                                        </ComboBoxItem>
                                                        <ComboBoxItem>
                                                            <TextBlock Text="Times New Roman" Foreground="Black"/>
                                                        </ComboBoxItem>
                                                    </ComboBox>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Font style" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                            <ComboBox HorizontalAlignment="Stretch">
                                                                <ComboBoxItem IsSelected="True">
                                                                    <TextBlock Text="Regular" Foreground="Black"/>
                                                                </ComboBoxItem>
                                                                <ComboBoxItem>
                                                                    <TextBlock Text="Italic" Foreground="Black"/>
                                                                </ComboBoxItem>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Font weight" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                            <ComboBox HorizontalAlignment="Stretch">
                                                                <ComboBoxItem IsSelected="True">
                                                                    <TextBlock Text="Regular" Foreground="Black"/>
                                                                </ComboBoxItem>
                                                                <ComboBoxItem>
                                                                    <TextBlock Text="Bold" Foreground="Black"/>
                                                                </ComboBoxItem>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="Font size" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBox Text="12" Height="28" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10" VerticalContentAlignment="Center" Background="White" Foreground="Black" BorderBrush="#CCCCCC"/>

                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Font color" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                            <Button Height="28" Width="60" HorizontalAlignment="Left" Background="White" BorderBrush="#888888">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Rectangle Width="16" Height="14" Fill="Black" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="▼" FontSize="8" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Background" Foreground="#555555" FontSize="11" Margin="0,0,0,3"/>
                                                            <Button Height="28" Width="60" HorizontalAlignment="Left" Background="White" BorderBrush="#888888">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="16" Height="14" Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="1">
                                                                        <TextBlock Text="X" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666"/>
                                                                    </Border>
                                                                    <TextBlock Text="▼" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Bottom Buttons -->
                <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                    <Border Padding="15,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="Save" Style="{StaticResource StableButtonStyle}" Width="80" Margin="0,0,10,0"/>
                            <Button Content="Close" 
                                    Command="{Binding CloseCredentialCommand}"
                                    Style="{StaticResource StableButtonStyle}" Background="#B0BEC5" Width="80"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Canvas>
</UserControl>
