<UserControl x:Class="IDCard.Desktop.Views.WorkflowDesignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Stable Button Style -->
        <Style x:Key="StableButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="White">
        <!-- ၁။ ပထမဦးဆုံးပေါ်ရမည့် မျက်နှာပြင်: Create New Workflow ခလုတ်ပါသော စာမျက်နှာ (IsListVisible ကိုသုံးသည်) -->
        <Grid Margin="20,5,20,20" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Button Content="Create New Workflow" 
                            Command="{Binding CreateNewWorkflowCommand}"
                            Style="{StaticResource StableButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ၂။ "Create New Workflow" ခလုတ်ကို နှိပ်မှ ပေါ်လာမည့် Workflow Designer မျက်နှာပြင် (IsEditingWorkflow ကိုသုံးသည်) -->
        <Grid Visibility="{Binding IsEditingWorkflow, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- ထိပ်ဆုံးခရမ်းရောင် Sub-Header (Workflow Design 1 နှင့် Properties Tabs) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#7B1FA2" Margin="0">
                <Border Padding="10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Workflow Design 1" Width="140" Height="30" Background="White" Foreground="#7B1FA2" FontWeight="Bold" BorderThickness="0" Margin="0,0,5,0"/>
                        <Button Content="Properties" Width="100" Height="30" Background="Transparent" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- အလယ်ပိုင်း Main Content Area (ဘယ်ဘက် Steps, အလယ် Canvas, ညာဘက် Properties) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- ဘယ်ဘက်ခြမ်း: Workflow Steps Panel -->
                <Border Grid.Column="0" Background="#EEEEEE" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Workflow Steps" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,15"/>
                        <Button Content="Add Steps" Style="{StaticResource StableButtonStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- အလယ်ဗဟို: Main Workspace Canvas -->
                <Border Grid.Column="1" Background="White"/>

                <!-- ညာဘက်ခြမ်း: Properties Panel (General Properties) -->
                <Border Grid.Column="2" Background="#EEEEEE" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Properties" FontWeight="Bold" FontSize="14" Foreground="#333333" Margin="0,0,0,15"/>
                        
                        <!-- General Section -->
                        <Expander Header="General" IsExpanded="True" FontWeight="SemiBold" Foreground="#333333">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Step name" FontWeight="Normal" Foreground="Gray" Margin="0,0,0,5"/>
                                <TextBox Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- အောက်ဆုံး Buttons (Save, Save As..., Close) -->
            <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                <Border Padding="15,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Save" Style="{StaticResource StableButtonStyle}" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Save As..." Style="{StaticResource StableButtonStyle}" Background="#757575" Width="90" Margin="0,0,10,0"/>
                        <Button Content="Close" 
                                Command="{Binding CloseWorkflowCommand}"
                                Style="{StaticResource StableButtonStyle}" Background="#B0BEC5" Width="80"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
