<UserControl x:Class="IDCard.Desktop.Views.WorkflowDesignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Stable Button Style -->
        <Style x:Key="StableButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="White">
        <!-- ၁။ ပထမဦးဆုံးပေါ်ရမည့် မျက်နှာပြင်: "Create New Workflow" ခလုတ်သာပါသော စာမျက်နှာ -->
        <Grid Margin="20,20,20,20">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- IsEditingWorkflow သည် true ဖြစ်သွားပါက ဤခလုတ်ပါသော မျက်နှာပြင် ပျောက်သွားမည် -->
                        <DataTrigger Binding="{Binding IsEditingWorkflow}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Button Content="Create New Workflow" 
                        Command="{Binding CreateNewWorkflowCommand}"
                        Style="{StaticResource StableButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ၂။ "Create New Workflow" ခလုတ်ကို နှိပ်မှသာ ပေါ်လာမည့် Workflow Designer မျက်နှာပြင် (အပြည့်အစုံ) -->
        <Grid Background="#E0E0E0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <!-- IsEditingWorkflow သည် true ဖြစ်မှသာ ဤ Designer မျက်နှာပြင် ပေါ်လာမည် -->
                        <DataTrigger Binding="{Binding IsEditingWorkflow}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- အလယ်ပိုင်း Main Content Area (ဘယ်ဘက် Steps, အလယ် Canvas, ညာဘက် Properties) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- ဘယ်ဘက်ခြမ်း: Workflow Steps Panel -->
                <Border Grid.Column="0" Background="#EFEFEF" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Workflow Steps" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,15"/>
                        <Button Content="Add Steps" Style="{StaticResource StableButtonStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- အလယ်ဗဟို: Main Workspace Canvas -->
                <Border Grid.Column="1" Background="White" Margin="10"/>

                <!-- ညာဘက်ခြမ်း: Properties Panel -->
                <Border Grid.Column="2" Background="#EFEFEF" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Properties" FontWeight="Bold" FontSize="14" Foreground="#333333" Margin="0,0,0,10"/>
                        
                        <!-- Steps / Fields Toggle Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="Steps" Width="120" Height="30" Background="White" Foreground="#333333" FontWeight="Bold" BorderBrush="#CCCCCC" BorderThickness="1"/>
                            <Button Content="Fields" Width="120" Height="30" Background="#E0E0E0" Foreground="#555555" FontWeight="SemiBold" BorderBrush="#CCCCCC" BorderThickness="1,1,1,1"/>
                        </StackPanel>

                        <!-- General Section -->
                        <Expander Header="General" IsExpanded="True" FontWeight="SemiBold" Foreground="#333333">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Step name" FontWeight="Normal" Foreground="Gray" Margin="0,0,0,5"/>
                                <TextBox Height="30" VerticalContentAlignment="Center" Padding="5,0" BorderBrush="#CCCCCC"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- အောက်ဆုံး Buttons (Save, Save As..., Close) -->
            <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                <Border Padding="15,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Save" Style="{StaticResource StableButtonStyle}" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Save As..." Style="{StaticResource StableButtonStyle}" Background="#757575" Width="90" Margin="0,0,10,0"/>
                        <Button Content="Close" 
                                Command="{Binding CloseWorkflowCommand}"
                                Style="{StaticResource StableButtonStyle}" Background="#B0BEC5" Width="80"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
