<ui:Window x:Class="IDCard.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        Title="Login - Desktop ID Card System" 
        Height="500" Width="480" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    
    <ui:Window.DataContext>
        <vm:LoginViewModel/>
    </ui:Window.DataContext>

    <!-- Background - Modern Fluent Purple Theme -->
    <Grid Background="#6B21A8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
            
            <!-- White Card Container using ModernWPF CardControl -->
            <ui:CardControl Padding="30,35" Background="White">
                <StackPanel>
                    <!-- User ID Field -->
                    <TextBlock Text="User ID" FontSize="14" FontWeight="SemiBold" Foreground="#6B21A8" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Height="38" FontSize="14" Margin="0,0,0,20"
                             ui:ControlHelper.PlaceholderText="Enter username"/>

                    <!-- Password Field using PasswordBox -->
                    <TextBlock Text="Password" FontSize="14" FontWeight="SemiBold" Foreground="#6B21A8" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBoxControl" 
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Height="38" FontSize="14"/>
                </StackPanel>
            </ui:CardControl>

            <!-- Forgot Password Link -->
            <TextBlock Text="Forgot Password?" MouseDown="ForgotPassword_Click" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,15" Cursor="Hand"/>

            <!-- Sign In Button using ModernWPF Accent Style -->
            <Button Content="Sign In" 
                    Command="{Binding LoginCommand}" 
                    Width="180" Height="42" 
                    Style="{StaticResource AccentButtonStyle}"
                    FontSize="14" FontWeight="Bold" Cursor="Hand"/>
            
        </StackPanel>
    </Grid>
</ui:Window>
