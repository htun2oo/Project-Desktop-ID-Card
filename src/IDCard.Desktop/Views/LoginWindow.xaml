<Window x:Class="IDCard.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Login - Desktop ID Card System" 
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#6A1B9A" CornerRadius="10" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ညာဘက်အပေါ်ထောင့်တွင် Window ပိတ်ရန် Close ခလုတ် -->
            <Button Content="✕" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Width="35" Height="35" 
                    Background="Transparent" Foreground="White" 
                    FontSize="16" FontWeight="Bold"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Click="CloseButton_Click"
                    Panel.ZIndex="10"/>

            <!-- Desktop ID Card System ခေါင်းစဉ် -->
            <TextBlock Text="Desktop ID Card System" 
                       Foreground="White" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Margin="0,15,0,20"/>

            <!-- အဖြူရောင် Login Form ကွက် -->
            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="30,25,30,25" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                <StackPanel HorizontalAlignment="Stretch">
                    
                    <!-- User ID -->
                    <TextBlock Text="User ID" Foreground="#4A148C" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Height="35" HorizontalAlignment="Stretch" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                    <!-- Password -->
                    <TextBlock Text="Password" Foreground="#4A148C" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" 
                                 Height="35" HorizontalAlignment="Stretch" Margin="0,0,
