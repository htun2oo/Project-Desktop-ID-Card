<Window x:Class="IDCard.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IDCard.Desktop.ViewModels"
        Title="Login - IDCard System" Height="480" Width="480" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <!-- Background - Entrust Purple Theme -->
    <Grid Background="#6B21A8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
            
            <!-- White Card Container -->
            <Border Background="White" CornerRadius="12" Padding="30,35" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <!-- User ID Field -->
                    <TextBlock Text="User ID" FontSize="14" FontWeight="SemiBold" Foreground="#6B21A8" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" FontSize="14" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,20"/>

                    <!-- Password Field (Using TextBox with PasswordChar equivalent or standard TextBox for simplicity) -->
                    <TextBlock Text="Password" FontSize="14" FontWeight="SemiBold" Foreground="#6B21A8" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" FontSize="14" BorderBrush="#D1D5DB" BorderThickness="1"/>
                </StackPanel>
            </Border>

            <!-- Forgot Password Link -->
            <TextBlock Text="Forgot Password?" MouseDown="ForgotPassword_Click" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,15" Cursor="Hand"/>

            <!-- Sign In Button -->
            <Button Content="Sign In" Command="{Binding LoginCommand}" Width="180" Height="40" Background="#2563EB" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            
        </StackPanel>
    </Grid>
</Window>
